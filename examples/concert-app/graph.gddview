tring"}},"output":{"properties":{"principal":{"properties":{"id":{"min_length":1,"type":"string"},"name":{"min_length":1,"type":"string"}},"required":["id","name"],"type":"object"}},"required":["principal"],"type":"object"},"postconditions":["Validate server-owned fictional credentials, establish an unpredictable opaque session, and return public principal information."],"preconditions":["Validate the declared input and resolve any required session before exposing private data."],"risks":{"atomicity":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"authorization":{"rationale":"The negative scenario covers session/credential rejection.","relevant":true,"scenarios":["scenario.app.action.login.negative"]},"boundaries":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"concurrency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"idempotency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]}}},"description":"Validate server-owned fictional credentials, establish an unpredictable opaque session, and return public principal information.","kind":"action","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.http"}]},"action.logout":{"behavior":"Revoke the presented session and expire its cookie; repeated logout is harmless and must not revoke other tokens.","contract":{"context":{"session_token":{"nullable":true,"optional":true,"type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"SessionChanged":["scenario.ui_session_change"]},"errors":{"SessionChanged":"At the HTTP boundary reject a s