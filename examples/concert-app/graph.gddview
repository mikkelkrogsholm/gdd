ction.cancel"},{"from":"scenario.ui_session_change","id":"edge.app.scenario.ui_session_change.exercises.action.list_own_reservations","relation":"exercises","to":"action.list_own_reservations"},{"from":"scenario.ui_session_change","id":"edge.app.scenario.ui_session_change.exercises.action.logout","relation":"exercises","to":"action.logout"},{"from":"scenario.ui_session_change","id":"edge.app.scenario.ui_session_change.verifies.rule.auth_context","relation":"verifies","to":"rule.auth_context"},{"from":"scenario.ui_session_change","id":"edge.app.scenario.ui_session_change.verifies.rule.ui_complete","relation":"verifies","to":"rule.ui_complete"},{"from":"rule.active_limit","id":"edge.app.rule.active_limit.constrains.action.reserve","relation":"constrains","to":"action.reserve"},{"from":"rule.active_limit","id":"edge.app.rule.active_limit.constrains.action.list_own_reservations","relation":"constrains","to":"action.list_own_reservations"},{"from":"rule.active_limit","id":"edge.app.rule.active_limit.constrains.entity.reservation","relation":"constrains","to":"entity.reservation"},{"from":"scenario.active_limit","id":"edge.app.scenario.active_limit.exercises.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.active_limit","id":"edge.app.scenario.active_limit.exercises.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.active_limit","id":"edge.app.scenario.active_limit.exercises.action.list_own_reservations","relation":"exercises","to":"action.list_own_reservations"},{"from":"scenario.active_limit","id":"edge.app.scenario.active_limit.verifies.rule.active_limit","relation":"verifies","to":"rule.active_limit"},{"from":"scenario.active_limit_concurrent","id":"edge.app.scenario.active_limit_concurrent.exercises.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.active_limit_concurrent","id":"edge.app.scenario.active_limit_concurrent.exercises.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.active_limit_concurrent","id":"edge.app.scenario.active_limit_concurrent.exercises.action.list_own_reservations","relation":"exercises","to":"action.list_own_reservations"},{"from":"scenario.active_limit_concurrent","id":"edge.app.scenario.active_limit_concurrent.verifies.rule.active_limit","relation":"verifies","to":"rule.active_limit"},{"from":"scenario.active_limit_replay","id":"edge.app.scenario.active_limit_replay.exercises.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.active_limit_replay","id":"edge.app.scenario.active_limit_replay.exercises.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.active_limit_replay","id":"edge.app.scenario.active_limit_replay.exercises.action.list_own_reservations","relation":"exercises","to":"action.list_own_reservations"},{"from":"scenario.active_limit_replay","id":"edge.app.scenario.active_limit_replay.verifies.rule.active_limit","relation":"verifies","to":"rule.active_limit"}],"format":"gdd/0.3","nodes":{"action.cancel":{"behavior":"Validate identity and input first.\nAn absent reservation and another owner's reservation both yield ReservationNotFound.\nCheck ownership before returning data, including a retry for an already cancelled reservation.\nAtomically change reserved to cancelled so the reservation no longer occupies a seat.\nReturn cancelled unchanged; do not release a seat again.\nPreserve the old request key so a repeated reserve request cannot recreate the reservation.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"InvalidInput":["scenario.cancel_invalid"],"PersistenceUnavailable":["scenario.atomic_failure"],"ReservationNotFound":["scenario.reservation_missing","scenario.foreign_cancel"],"SessionChanged":["scenario.ui_session_change"],"Unauthenticated":["scenario.cancel_unauthenticated"]},"errors":{"InvalidInput":"Reject malformed input before any reservation mutation.","PersistenceUnavailable":"Rollback before returning failure; no partial effects or new key binding.","ReservationNotFound":"Return an error when the reservation does not exist; change no reservation.","SessionChanged":"At the HTTP boundary reject a stale presented identity before private reads or effects; the expectation never selects the authenticated principal.","Unauthenticated":"Reject before lookup or mutation when trusted authentication is absent."},"external_effects":[],"input":{"reservation_id":{"min_length":1,"type":"string"}},"output":{"properties":{"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["cancelled"]}},"required":["id","state"],"type":"object"},"postconditions":["An owned active reservation becomes cancelled atomically.","An already cancelled owned reservation remains cancelled.","Reject a stale browser identity expectation against the server-resolved session before reading personal data or applying effects."],"preconditions":["Validate authenticated identity and input before lookup or mutation."],"risks":{"atomicity":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.atomic_failure"]},"authorization":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.foreign_cancel"]},"boundaries":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.reservation_missing"]},"concurrency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.cancel_concurrent"]},"idempotency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.cancel","scenario.replay_after_cancel"]}}},"description":"The owner may cancel their reservation; repeating the request has no additional effect.","kind":"action","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"},{"purpose":"contract","source":"source.http"}]},"action.catalog":{"behavior":"Return fictional concerts with observational availability; this does not promise a subsequent booking.","contract":{"context":{},"dependencies_complete":true,"effects_complete":true,"error_cases":{"PersistenceUnavailable":["scenario.app.action.catalog.negative"]},"errors":{"PersistenceUnavailable":"No partial response or mutation."},"external_effects":[],"input":{},"output":{"properties":{"concerts":{"items":{"properties":{"available":{"minimum":0,"type":"integer"},"capacity":{"minimum":0,"type":"integer"},"date":{"min_length":1,"type":"string"},"id":{"min_length":1,"type":"string"},"title":{"min_length":1,"type":"string"},"venue":{"min_length":1,"type":"string"}},"required":["id","title","date","venue","capacity","available"],"type":"object"},"type":"array"}},"required":["concerts"],"type":"object"},"postconditions":["Return fictional concerts with observational availability; this does not promise a subsequent booking."],"preconditions":["Validate the declared input and resolve any required session before exposing private data."],"risks":{"atomicity":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"authorization":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"boundaries":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"concurrency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"idempotency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]}}},"description":"Return fictional concerts with observational availability; this does not promise a subsequent booking.","kind":"action","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.http"}]},"action.current_session":{"behavior":"Resolve an opaque token server-side; return its public principal or null without trusting request-body identity.","contract":{"context":{"session_token":{"nullable":true,"optional":true,"type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{},"errors":{},"external_effects":[],"input":{},"output":{"properties":{"principal":{"nullable":true,"properties":{"id":{"min_length":1,"type":"string"},"name":{"min_length":1,"type":"string"}},"required":["id","name"],"type":"object"}},"required":["principal"],"type":"object"},"postconditions":["Resolve an opaque token server-side; return its public principal or null without trusting request-body identity."],"preconditions":["Validate the declared input and resolve any required session before exposing private data."],"risks":{"atomicity":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"authorization":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"boundaries":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"concurrency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"idempotency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]}}},"description":"Resolve an opaque token server-side; return its public principal or null without trusting request-body identity.","kind":"action","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.http"}]},"action.list_own_reservations":{"behavior":"Return only this principal's complete reserved/cancelled history, active count and current nullable domain-owned limit.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"PersistenceUnavailable":["scenario.app.action.list_own_reservations.negative"],"SessionChanged":["scenario.ui_session_change"],"Unauthenticated":["scenario.app.action.list_own_reservations.negative"]},"errors":{"PersistenceUnavailable":"Return no partial private data.","SessionChanged":"At the HTTP boundary reject a stale presented identity before private reads or effects; the expectation never selects the authenticated principal.","Unauthenticated":"Reject before persistence lookup."},"external_effects":[],"input":{},"output":{"properties":{"active_count":{"minimum":0,"type":"integer"},"active_limit":{"minimum":1,"nullable":true,"type":"integer"},"reservations":{"items":{"properties":{"concert_id":{"min_length":1,"type":"string"},"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["reserved","cancelled"]}},"required":["id","concert_id","state"],"type":"object"},"type":"array"}},"required":["reservations","active_count","active_limit"],"type":"object"},"postconditions":["Return only this principal's complete reserved/cancelled history, active count and current nullable domain-owned limit.","Reject a stale browser identity expectation against the server-resolved session before reading personal data or applying effects.","Return active_limit=2 from the domain's single policy value."],"preconditions":["Validate the declared input and resolve any required session before exposing private data."],"risks":{"atomicity":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"authorization":{"rationale":"The negative scenario covers session/credential rejection.","relevant":true,"scenarios":["scenario.app.action.list_own_reservations.negative"]},"boundaries":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"concurrency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"idempotency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]}}},"description":"Return only this principal's complete reserved/cancelled history, active count and current nullable domain-owned limit.","kind":"action","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.http"}]},"action.login":{"behavior":"Validate server-owned fictional credentials, establish an unpredictable opaque session, and return public principal information.","contract":{"context":{},"dependencies_complete":true,"effects_complete":true,"error_cases":{"InvalidCredentials":["scenario.app.action.login.negative"]},"errors":{"InvalidCredentials":"Establish no session and return no credential details."},"external_effects":["Issue an HttpOnly SameSite=Strict session cookie."],"input":{"password":{"min_length":1,"type":"string"},"username":{"min_length":1,"type":"string"}},"output":{"properties":{"principal":{"properties":{"id":{"min_length":1,"type":"string"},"name":{"min_length":1,"type":"string"}},"required":["id","name"],"type":"object"}},"required":["principal"],"type":"object"},"postconditions":["Validate server-owned fictional credentials, establish an unpredictable opaque session, and return public principal information."],"preconditions":["Validate the declared input and resolve any required session before exposing private data."],"risks":{"atomicity":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"authorization":{"rationale":"The negative scenario covers session/credential rejection.","relevant":true,"scenarios":["scenario.app.action.login.negative"]},"boundaries":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"concurrency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"idempotency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]}}},"description":"Validate server-owned fictional credentials, establish an unpredictable opaque session, and return public principal information.","kind":"action","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.http"}]},"action.logout":{"behavior":"Revoke the presented session and expire its cookie; repeated logout is harmless and must not revoke other tokens.","contract":{"context":{"session_token":{"nullable":true,"optional":true,"type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"SessionChanged":["scenario.ui_session_change"]},"errors":{"SessionChanged":"At the HTTP boundary reject a stale presented identity before private reads or effects; the expectation never selects the authenticated principal."},"external_effects":["Expire the presented session cookie."],"input":{},"output":{"properties":{"principal":{"nullable":true,"type":"any"}},"required":["principal"],"type":"object"},"postconditions":["Revoke the presented session and expire its cookie; repeated logout is harmless and must not revoke other tokens.","Reject a stale browser identity expectation against the server-resolved session before reading personal data or applying effects."],"preconditions":["Validate the declared input and resolve any required session before exposing private data."],"risks":{"atomicity":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"authorization":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"boundaries":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"concurrency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"idempotency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]}}},"description":"Revoke the presented session and expire its cookie; repeated logout is harmless and must not revoke other tokens.","kind":"action","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.http"}]},"action.reserve":{"behavior":"Validate identity and input before lookup or mutation.\nThe request key is scoped to principal_id and action.reserve.\nBind a successful key to concert_id and reservation ID; reusing the key with another concert_id yields IdempotencyConflict.\nAn identical retry returns the same reservation ID and CURRENT state, including after cancellation, without new side effects.\nLook up an earlier success BEFORE checking new capacity; a full venue must not turn a successful retry into SoldOut.\nOnly a new key attempts to create a new reservation.\nReject a new reservation with SoldOut when the number of reservations in reserved equals capacity.\nKey uniqueness, capacity protection, creation and key binding must be part of the same atomic database operation or transaction.\nConcurrent transactions must produce a result equivalent to a valid sequential order under these rules; an unprotected check-then-insert is insufficient.\nA failed creation does not bind the request key and leaves no reservation.\nFor a new key, after resolving concert existence enforce the principal's global active limit of two BEFORE concert capacity. Both counts, insert and key binding are in one protected transaction. Successful replay remains before either limit.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"ActiveReservationLimitReached":["scenario.active_limit"],"ConcertNotFound":["scenario.concert_missing"],"IdempotencyConflict":["scenario.key_conflict"],"InvalidInput":["scenario.reserve_invalid"],"PersistenceUnavailable":["scenario.atomic_failure"],"SessionChanged":["scenario.ui_session_change"],"SoldOut":["scenario.sold_out"],"Unauthenticated":["scenario.reserve_unauthenticated"]},"errors":{"ActiveReservationLimitReached":"Reject a new key at two active reservations without mutation or key binding.","ConcertNotFound":"Return an error and create no reservation when the concert does not exist.","IdempotencyConflict":"Reject a request key already bound to another concert; leave the existing reservation unchanged.","InvalidInput":"Reject malformed input before any reservation mutation.","PersistenceUnavailable":"Rollback before returning failure; no partial effects or new key binding.","SessionChanged":"At the HTTP boundary reject a stale presented identity before private reads or effects; the expectation never selects the authenticated principal.","SoldOut":"Return an error and create no reservation when no seat is available.","Unauthenticated":"Reject before lookup or mutation when trusted authentication is absent."},"external_effects":[],"input":{"concert_id":{"min_length":1,"type":"string"},"request_key":{"min_length":1,"type":"string"}},"output":{"properties":{"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["reserved","cancelled"]}},"required":["id","state"],"type":"object"},"postconditions":["A new reservation is created atomically only when capacity is available.","A successful repeated request returns its original reservation in its current state and creates no additional reservation.","Reject a stale browser identity expectation against the server-resolved session before reading personal data or applying effects.","Each principal has at most two reserved reservations across all concerts. Cancelled history does not consume allowance."],"preconditions":["Validate authenticated identity and input before lookup or mutation."],"risks":{"atomicity":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.atomic_failure"]},"authorization":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.reserve_unauthenticated"]},"boundaries":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.zero_capacity","scenario.sold_out"]},"concurrency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.last_seat","scenario.concurrent_same_key","scenario.active_limit_concurrent"]},"idempotency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.replay","scenario.key_conflict"]}}},"description":"Reserve exactly one seat or retrieve an earlier successful result.","kind":"action","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"},{"purpose":"contract","source":"source.http"}]},"community.backend":{"description":"Backend view of the shared model.","kind":"community","source_refs":[{"purpose":"contract","source":"source.requirements"}]},"community.frontend":{"description":"Frontend view of the shared model.","kind":"community","source_refs":[{"purpose":"contract","source":"source.requirements"}]},"community.reservation_feature":{"description":"Cross-cutting reservation feature view; membership grants no permissions.","kind":"community","source_refs":[{"purpose":"contract","source":"source.requirements"}]},"component.api":{"boundary":{"excludes":["Seat allocation and reservation lifecycle decisions.","Physical persistence operations."],"rationale":"Keep transport changes separate from reservation and persistence decisions.","responsibility":"Translate transport requests and forward trusted authentication context."},"description":"Validates transport input and forwards authenticated context.","interfaces":[],"kind":"component","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"}]},"component.frontend":{"boundary":{"excludes":["Authoritative seat allocation and access-control decisions."],"rationale":"Let presentation change while preserving the reservation operation contracts.","responsibility":"Present reservation interactions and their user-visible states."},"description":"Present the local concert catalog, session flow and personal reservation history.","interfaces":[],"kind":"component","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"}]},"component.identity":{"boundary":{"excludes":["Reservation decisions and physical reservation persistence."],"rationale":"Session decisions can change independently of transport and reservation policy.","responsibility":"Credential validation, session resolution and revocation."},"description":"Authenticate fictional credentials and own the opaque session registry.","interfaces":["action.login","action.logout","action.current_session"],"kind":"component"},"component.reservations":{"boundary":{"excludes":["Transport request/response translation.","Physical storage implementation."],"rationale":"Keep availability, atomicity and cancellation rules consistent behind one public interface.","responsibility":"Own reservation rules, access control and transaction decisions."},"description":"Owns reservation rules, access control and transaction boundaries.","interfaces":["action.reserve","action.cancel","action.catalog","action.list_own_reservations"],"kind":"component","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"}]},"component.storage":{"boundary":{"excludes":["Authentication and reservation policy decisions."],"rationale":"Isolate database-specific behavior behind the domain persistence boundary.","responsibility":"Implement persistence and transactions selected by the reservation component."},"description":"Database persistence adapter; contains no access-control decisions.","interfaces":[],"kind":"component","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"}]},"entity.concert":{"description":"A concert with a fixed nonnegative integer capacity.","fields":{"capacity":{"minimum":0,"type":"integer"},"date":{"min_length":1,"type":"string"},"id":{"min_length":1,"type":"string"},"title":{"min_length":1,"type":"string"},"venue":{"min_length":1,"type":"string"}},"kind":"entity","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"}]},"entity.reservation":{"description":"One reserved seat with an owner and permanent request key.","fields":{"concert_id":{"min_length":1,"type":"string"},"id":{"min_length":1,"type":"string"},"owner_id":{"min_length":1,"type":"string"},"request_key":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["reserved","cancelled"]}},"kind":"entity","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"}]},"entity.session":{"description":"An opaque in-memory session mapped to one fictional principal.","fields":{"principal_id":{"min_length":1,"type":"string"},"token":{"min_length":1,"type":"string"}},"kind":"entity"},"machine.reservation":{"annotations":{"gdd.notes":["absent is a modeling marker for a reservation that does not yet exist; it is never stored.","The state machine describes mutations. Validation, errors and idempotent return paths are defined in the action contracts.","cancelled is terminal for mutations but may still be read and returned during an authorized retry."]},"description":"Reservation mutation lifecycle; retries and errors follow the action contracts.","kind":"machine","machine":{"initial":"absent","states":["absent","reserved","cancelled"],"terminal":["cancelled"],"transitions":[{"effects":"Create a reservation with state=reserved and bind the request key atomically under capacity protection.","from":"absent","guard":"Authenticated user; existing concert; new request key; at least one available seat. AND the principal has fewer than two active reservations across all concerts.","id":"transition.reserve","to":"reserved","trigger":"action.reserve"},{"effects":"Atomically change to cancelled; any materialized seat counter is updated within the same transaction.","from":"reserved","guard":"The authenticated user owns the reservation.","id":"transition.cancel","to":"cancelled","trigger":"action.cancel"}]},"maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.active_limit":{"description":"Each principal has at most two reserved reservations across all concerts. Cancelled history does not consume allowance.","kind":"rule","rule":{"blocking":true,"category":"invariant","scope":"targeted","statement":"Each principal has at most two reserved reservations across all concerts. Cancelled history does not consume allowance.","verification":["pytest_concert"]}},"rule.api_boundary":{"description":"The API module must not import the persistence module directly.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"architecture","constraint":{"from":"component.api","policy":"forbid","reach":"direct","relation":"imports","to":"component.storage"},"scope":"targeted","statement":"The API module must not import the persistence module directly.","verification":["python_import_graph"]},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.atomicity":{"description":"Errors before commit leave no partially completed mutation or request-key binding.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Errors before commit leave no partially completed mutation or request-key binding.","verification":["pytest_concert"]},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.auth_context":{"description":"Only the server-resolved session principal can access personal data or mutate reservations; request-body identity has no authority.","kind":"rule","rule":{"blocking":true,"category":"invariant","scope":"targeted","statement":"Only the server-resolved session principal can access personal data or mutate reservations; request-body identity has no authority.","verification":["pytest_concert"]}},"rule.authorization":{"description":"Only the owner may cancel or receive reservation data; the request body must not determine identity.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Only the owner may cancel or receive reservation data; the request body must not determine identity.","verification":["pytest_concert"]},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.capacity":{"description":"For each concert, 0 <= count(reservations with state=reserved) <= capacity after every committed mutation.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"invariant","scope":"targeted","statement":"For each concert, 0 <= count(reservations with state=reserved) <= capacity after every committed mutation.","verification":["pytest_concert"]},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.design.dry":{"description":"Reservation and cancellation reuse one authoritative definition of each business rule; similar code alone does not require abstraction.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"dry","scope":"global","statement":"Reservation and cancellation reuse one authoritative definition of each business rule; similar code alone does not require abstraction.","verification":["design_review"]},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.design.kiss":{"description":"Each layer and abstraction serves a current requirement; prefer the smallest clear implementation.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"kiss","scope":"global","statement":"Each layer and abstraction serves a current requirement; prefer the smallest clear implementation.","verification":["design_review"]},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.design.modularity":{"description":"Components collaborate through public contracts and can change their internals without exposing them to consumers.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"modularity","scope":"global","statement":"Components collaborate through public contracts and can change their internals without exposing them to consumers.","verification":["design_review"]},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.design.separation_of_concerns":{"description":"Transport, reservation decisions and physical storage remain with their responsible components.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"separation_of_concerns","scope":"global","statement":"Transport, reservation decisions and physical storage remain with their responsible components.","verification":["design_review"]},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.idempotency":{"description":"Retries must not create extra reservations, reactivate cancelled reservations or release extra seats.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Retries must not create extra reservations, reactivate cancelled reservations or release extra seats.","verification":["pytest_concert"]},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.state_machine":{"description":"Mutating flows follow the state machine; cancelled reservation IDs cannot be reactivated.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Mutating flows follow the state machine; cancelled reservation IDs cannot be reactivated.","verification":["pytest_concert"]},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"rule.ui_complete":{"description":"The complete local user flow, responsive layout, keyboard operation and failure recovery follow the pinned design contract.","kind":"rule","rule":{"blocking":true,"category":"design","scope":"targeted","statement":"The complete local user flow, responsive layout, keyboard operation and failure recovery follow the pinned design contract.","verification":["browser_concert"]}},"scenario.active_limit":{"description":"Preserve replay semantics and enforce the global limit atomically without binding failed keys; cancellation frees allowance.","kind":"scenario","scenario":{"category":"boundary","given":"Real persistent reservations exist for separate principals.","then":"Preserve replay semantics and enforce the global limit atomically without binding failed keys; cancellation frees allowance.","when":"Attempt a third distinct-key reservation in a concert with free capacity."}},"scenario.active_limit_concurrent":{"description":"Preserve replay semantics and enforce the global limit atomically without binding failed keys; cancellation frees allowance.","kind":"scenario","scenario":{"category":"concurrency","given":"Real persistent reservations exist for separate principals.","then":"Preserve replay semantics and enforce the global limit atomically without binding failed keys; cancellation frees allowance.","when":"Submit two new keys concurrently across different concerts when the principal has one active reservation."}},"scenario.active_limit_replay":{"description":"Preserve replay semantics and enforce the global limit atomically without binding failed keys; cancellation frees allowance.","kind":"scenario","scenario":{"category":"boundary","given":"Real persistent reservations exist for separate principals.","then":"Preserve replay semantics and enforce the global limit atomically without binding failed keys; cancellation frees allowance.","when":"Replay a successful active or cancelled key while already at the limit; cancel and retry an unbound failed-limit key."}},"scenario.api_boundary":{"description":"The forbidden import must yield FAIL. An absent scan or unresolved mapping yields UNKNOWN, not PASS.","kind":"scenario","scenario":{"category":"architecture","given":"Component bindings point to the implemented project's modules.","then":"The forbidden import must yield FAIL. An absent scan or unresolved mapping yields UNKNOWN, not PASS.","when":"Extract the import graph; also insert a temporary direct API-to-storage import as a negative control."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.app.action.catalog.negative":{"description":"Return the declared failure without exposing private data or partial effects.","kind":"scenario","scenario":{"category":"negative","given":"Input, session or persistence cannot satisfy the declared contract.","then":"Return the declared failure without exposing private data or partial effects.","when":"Attempt the operation."}},"scenario.app.action.catalog.normal":{"description":"Return fictional concerts with observational availability; this does not promise a subsequent booking.","kind":"scenario","scenario":{"category":"normal","given":"The operation's declared preconditions hold.","then":"Return fictional concerts with observational availability; this does not promise a subsequent booking.","when":"Execute the public operation."}},"scenario.app.action.current_session.negative":{"description":"Return the declared failure without exposing private data or partial effects.","kind":"scenario","scenario":{"category":"negative","given":"Input, session or persistence cannot satisfy the declared contract.","then":"Return the declared failure without exposing private data or partial effects.","when":"Attempt the operation."}},"scenario.app.action.current_session.normal":{"description":"Resolve an opaque token server-side; return its public principal or null without trusting request-body identity.","kind":"scenario","scenario":{"category":"normal","given":"The operation's declared preconditions hold.","then":"Resolve an opaque token server-side; return its public principal or null without trusting request-body identity.","when":"Execute the public operation."}},"scenario.app.action.list_own_reservations.negative":{"description":"Return the declared failure without exposing private data or partial effects.","kind":"scenario","scenario":{"category":"negative","given":"Input, session or persistence cannot satisfy the declared contract.","then":"Return the declared failure without exposing private data or partial effects.","when":"Attempt the operation."}},"scenario.app.action.list_own_reservations.normal":{"description":"Return only this principal's complete reserved/cancelled history, active count and current nullable domain-owned limit.","kind":"scenario","scenario":{"category":"normal","given":"The operation's declared preconditions hold.","then":"Return only this principal's complete reserved/cancelled history, active count and current nullable domain-owned limit.","when":"Execute the public operation."}},"scenario.app.action.login.negative":{"description":"Return the declared failure without exposing private data or partial effects.","kind":"scenario","scenario":{"category":"negative","given":"Input, session or persistence cannot satisfy the declared contract.","then":"Return the declared failure without exposing private data or partial effects.","when":"Attempt the operation."}},"scenario.app.action.login.normal":{"description":"Validate server-owned fictional credentials, establish an unpredictable opaque session, and return public principal information.","kind":"scenario","scenario":{"category":"normal","given":"The operation's declared preconditions hold.","then":"Validate server-owned fictional credentials, establish an unpredictable opaque session, and return public principal information.","when":"Execute the public operation."}},"scenario.app.action.logout.negative":{"description":"Return the declared failure without exposing private data or partial effects.","kind":"scenario","scenario":{"category":"negative","given":"Input, session or persistence cannot satisfy the declared contract.","then":"Return the declared failure without exposing private data or partial effects.","when":"Attempt the operation."}},"scenario.app.action.logout.normal":{"description":"Revoke the presented session and expire its cookie; repeated logout is harmless and must not revoke other tokens.","kind":"scenario","scenario":{"category":"normal","given":"The operation's declared preconditions hold.","then":"Revoke the presented session and expire its cookie; repeated logout is harmless and must not revoke other tokens.","when":"Execute the public operation."}},"scenario.atomic_failure":{"description":"Persistent state is unchanged after the failure; a successful retry applies the effect once. Also verify any counter and key binding.","kind":"scenario","scenario":{"category":"negative","given":"A valid reserve or cancel flow is ready for mutation.","then":"Persistent state is unchanged after the failure; a successful retry applies the effect once. Also verify any counter and key binding.","when":"The test adapter injects failures at relevant persistence boundaries before commit and lets the client retry."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.cancel":{"description":"Same ID in cancelled; zero active reservations; available seats never exceed capacity.","kind":"scenario","scenario":{"category":"boundary","given":"A owns a reserved reservation for a concert with capacity=1.","then":"Same ID in cancelled; zero active reservations; available seats never exceed capacity.","when":"A cancels twice, including concurrent requests."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.cancel_concurrent":{"description":"Both return the same cancelled ID; the seat is released only once.","kind":"scenario","scenario":{"category":"concurrency","given":"A owns one reserved reservation.","then":"Both return the same cancelled ID; the seat is released only once.","when":"Two connections cancel concurrently."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.cancel_invalid":{"description":"InvalidInput; no mutation.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; empty reservation_id.","then":"InvalidInput; no mutation.","when":"Cancel is called."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.cancel_once":{"description":"The same ID is returned as cancelled; one seat is released.","kind":"scenario","scenario":{"category":"normal","given":"A owns a reserved reservation.","then":"The same ID is returned as cancelled; one seat is released.","when":"A cancels once."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.cancel_unauthenticated":{"description":"Unauthenticated; no lookup or mutation.","kind":"scenario","scenario":{"category":"negative","given":"No server-authenticated principal.","then":"Unauthenticated; no lookup or mutation.","when":"Cancel is called."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.concert_missing":{"description":"ConcertNotFound; the key is not bound.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; new key; concert does not exist.","then":"ConcertNotFound; the key is not bound.","when":"Reserve is called."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.concurrent_same_key":{"description":"Both return the same reservation ID; exactly one reservation is created.","kind":"scenario","scenario":{"category":"concurrency","given":"C has capacity=2; A has not yet used K1.","then":"Both return the same reservation ID; exactly one reservation is created.","when":"A sends two identical reserve requests with K1 concurrently."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.foreign_cancel":{"description":"ReservationNotFound; no change and no reservation data returned.","kind":"scenario","scenario":{"category":"negative","given":"A owns reservation R; B is authenticated as B.","then":"ReservationNotFound; no change and no reservation data returned.","when":"B attempts to cancel R, including a forged owner_id in the request body. Repeat for both reserved and cancelled states."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.key_conflict":{"description":"IdempotencyConflict; no new reservation or capacity change in any concert.","kind":"scenario","scenario":{"category":"negative","given":"A has reserved concert C1 using K1.","then":"IdempotencyConflict; no new reservation or capacity change in any concert.","when":"A uses K1 for concert C2."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.last_seat":{"description":"Exactly one reservation succeeds; the other yields SoldOut; at most one seat is occupied. Run against the selected database's actual transaction behavior.","kind":"scenario","scenario":{"category":"concurrency","given":"Concert C has one available seat; A and B each have a new request key.","then":"Exactly one reservation succeeds; the other yields SoldOut; at most one seat is occupied. Run against the selected database's actual transaction behavior.","when":"Two separate database connections attempt concurrent reservations with controlled overlap."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.replay":{"description":"The same reservation ID is returned every time; no extra seat is occupied; no SoldOut on a retry.","kind":"scenario","scenario":{"category":"boundary","given":"C has capacity=1; A's reserve request with K1 succeeded and took the last seat.","then":"The same reservation ID is returned every time; no extra seat is occupied; no SoldOut on a retry.","when":"A repeats the same request several times, including concurrently."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.replay_after_cancel":{"description":"K1 returns R in cancelled without mutation. K2 may create a new ID if capacity is available; R remains cancelled.","kind":"scenario","scenario":{"category":"boundary","given":"A reserved using K1 and then cancelled reservation R.","then":"K1 returns R in cancelled without mutation. K2 may create a new ID if capacity is available; R remains cancelled.","when":"A repeats the original reserve request with K1 and then creates a new one with K2."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.reservation_missing":{"description":"ReservationNotFound without reservation data.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; reservation does not exist.","then":"ReservationNotFound without reservation data.","when":"Cancel is called."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.reserve":{"description":"One reservation ID in reserved for A, and exactly one seat occupied.","kind":"scenario","scenario":{"category":"normal","given":"Concert C has capacity=1 and no reservations; user A is authenticated.","then":"One reservation ID in reserved for A, and exactly one seat occupied.","when":"A reserves C using key K1."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.reserve_invalid":{"description":"InvalidInput; no mutation.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; empty concert_id or request_key.","then":"InvalidInput; no mutation.","when":"Reserve is called."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.reserve_unauthenticated":{"description":"Unauthenticated; no lookup or mutation.","kind":"scenario","scenario":{"category":"negative","given":"No server-authenticated principal.","then":"Unauthenticated; no lookup or mutation.","when":"Reserve is called with otherwise valid input."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.sold_out":{"description":"SoldOut; no mutation or key binding.","kind":"scenario","scenario":{"category":"negative","given":"The concert is full; the user has a new key.","then":"SoldOut; no mutation or key binding.","when":"Reserve is called."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"scenario.ui_complete":{"description":"Availability and private history reflect actual server state and the complete task is usable with keyboard and narrow layout.","kind":"scenario","scenario":{"category":"normal","given":"A signed-out visitor opens the real local app.","then":"Availability and private history reflect actual server state and the complete task is usable with keyboard and narrow layout.","when":"Sign in, reserve a seat, inspect personal history, cancel and sign out."}},"scenario.ui_recovery":{"description":"Show an actionable error, preserve uncertain reserve keys, expose no foreign history and do not duplicate effects.","kind":"scenario","scenario":{"category":"negative","given":"Credentials, session, capacity or network cannot satisfy a request.","then":"Show an actionable error, preserve uncertain reserve keys, expose no foreign history and do not duplicate effects.","when":"Attempt login/reserve/cancel and recover."}},"scenario.ui_session_change":{"description":"Return SessionChanged before effects; clear the stale personal view and require explicit sign-in. Bob's session and history remain intact.","kind":"scenario","scenario":{"category":"negative","given":"Two tabs share a cookie; one changes the session from Alice to Bob.","then":"Return SessionChanged before effects; clear the stale personal view and require explicit sign-in. Bob's session and history remain intact.","when":"The stale Alice tab tries a private refresh, reservation or logout."}},"scenario.zero_capacity":{"description":"SoldOut; zero active reservations.","kind":"scenario","scenario":{"category":"boundary","given":"The concert has capacity=0.","then":"SoldOut; zero active reservations.","when":"A valid new reservation is attempted."},"source_refs":[{"purpose":"contract","source":"source.requirements"}]},"screen.reserve":{"description":"Choose a concert, sign in, reserve, inspect history and cancel.","design_refs":[{"purpose":"contract","selector":{"kind":"whole-document"},"source":"source.design"}],"interaction":{"accessibility":["Labelled native forms and buttons, visible keyboard focus, semantic headings and status/error announcements.","Availability, cancellation and errors include text; no color-only meaning."],"behavior":"Use the shared HTTP contract. Retain a reserve key after uncertain transport failure. Clear private data on identity change and ignore stale responses. Render server text as text; show server-owned limits.","responsive":"One event column at 320px, up to three at 1120px, no page overflow, controls at least 44px high and usable at 200% zoom.","states":["loading","signed_out","ready","submitting","empty","error","sold_out","at_limit"]},"kind":"screen","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"}]}},"project":{"assumptions":["One seat per reservation. Multiple reservations with different request keys are allowed.","Concerts already exist, and capacity does not change in this example.","Identity comes from the server authentication layer, not a user_id in the request body.","Reservations do not expire automatically in this initial model.","Payment, ticket issuance, waiting lists and external events are outside this example.","Reservation history and successful request keys are retained; deletion is outside this example.","Phase B requires a compatible existing database; refuse incompatible over-limit state without changing history."],"goal":"A user can reserve and cancel a seat without overbooking.","id":"concert-reservations","scope":"Active phase B: at most two reserved reservations per principal across all concerts; preserve successful keys and compatible phase-A history.","title":"Local Sessions concert reservations","workflow":{"gates":{"acceptance":{"authorities":["actor.concert.lead"],"requirement":"none","scope":[]},"implementation":{"authorities":["actor.concert.lead"],"requirement":"none","scope":[]},"model_changes":{"authorities":["actor.concert.lead"],"requirement":"none","scope":[]}},"mandate":"The human authorized this bounded local app and the A-to-B requirement experiment. The host supplies operational authority separately.","mode":"autonomous"}},"record_files":["gdd.records.json"],"sources":{"source.design":{"format":"design-md/alpha","normative":true,"revision":{"sha256":"5feab6d4f7552d04ba9d9153f0415d0f7b50302f150038d20e0a7910e0497ddc"},"role":"design","title":"DESIGN.md","uri":"DESIGN.md"},"source.http":{"format":"markdown","normative":true,"revision":{"sha256":"2369e726b9ba81f6dabf8c08bea53970b449d346afa4ac0a03fc67c252400259"},"role":"knowledge","title":"HTTP.md","uri":"HTTP.md"},"source.requirements":{"format":"markdown","normative":true,"revision":{"sha256":"a92cabc4c1e7d6580edc7218d32637de3675fb3606d02d93b4354858d3c5a901"},"role":"knowledge","title":"REQUIREMENTS.md","uri":"REQUIREMENTS.md"},"source.seed":{"format":"gdd/0.3","normative":false,"revision":{"sha256":"cef7846b3913d1a2cf968abb1f68f6126fc6b5eb38c4ba55b35de55c8bf15696"},"role":"input","title":"Preserved GDD 0.3 reservation intent","uri":"https://github.com/mikkelkrogsholm/gdd/blob/d9f930b34e93351c85180273c1ef4c1aacf60ac1/examples/concert-0.3.gdd.yaml"}}},"perspectives":{"format":"gdd-perspectives/0.1","spec_revision":"sha256:fcc1dd8ef8d20fc4fa8d0718c27f3774b188d36caccb3d51037d82857bd77170","advisory":true,"product_extension":null,"unsupported_extensions":[],"component_data_links":[{"component":"component.identity","entity":"entity.session","via":"changes","edge_ids":["edge.app.action.logout.changes.entity.session","edge.app.action.logout.owned_by.component.identity"]},{"component":"component.identity","entity":"entity.session","via":"creates","edge_ids":["edge.app.action.login.creates.entity.session","edge.app.action.login.owned_by.component.identity"]},{"component":"component.identity","entity":"entity.session","via":"owned_by","edge_ids":["edge.app.entity.session.owned_by.component.identity"]},{"component":"component.identity","entity":"entity.session","via":"reads","edge_ids":["edge.app.action.current_session.owned_by.component.identity","edge.app.action.current_session.reads.entity.session"]},{"component":"component.identity","entity":"entity.session","via":"stored_in","edge_ids":["edge.app.entity.session.stored_in.component.identity"]},{"component":"component.reservations","entity":"entity.concert","via":"owned_by","edge_ids":["edge.owner.entity.concert"]},{"component":"component.reservations","entity":"entity.concert","via":"reads","edge_ids":["edge.app.action.catalog.owned_by.component.reservations","edge.app.action.catalog.reads.entity.concert"]},{"component":"component.reservations","entity":"entity.concert","via":"reads","edge_ids":["edge.effect.action.reserve.reads.entity.concert","edge.owner.action.reserve"]},{"component":"component.reservations","entity":"entity.reservation","via":"changes","edge_ids":["edge.effect.action.cancel.changes.entity.reservation","edge.owner.action.cancel"]},{"component":"component.reservations","entity":"entity.reservation","via":"creates","edge_ids":["edge.effect.action.reserve.creates.entity.reservation","edge.owner.action.reserve"]},{"component":"component.reservations","entity":"entity.reservation","via":"owned_by","edge_ids":["edge.owner.entity.reservation"]},{"component":"component.reservations","entity":"entity.reservation","via":"reads","edge_ids":["edge.app.action.catalog.owned_by.component.reservations","edge.app.action.catalog.reads.entity.reservation"]},{"component":"component.reservations","entity":"entity.reservation","via":"reads","edge_ids":["edge.app.action.list_own_reservations.owned_by.component.reservations","edge.app.action.list_own_reservations.reads.entity.reservation"]},{"component":"component.reservations","entity":"entity.reservation","via":"reads","edge_ids":["edge.effect.action.cancel.reads.entity.reservation","edge.owner.action.cancel"]},{"component":"component.reservations","entity":"entity.reservation","via":"reads","edge_ids":["edge.effect.action.reserve.reads.entity.reservation","edge.owner.action.reserve"]},{"component":"component.storage","entity":"entity.concert","via":"stored_in","edge_ids":["edge.storage.entity.concert"]},{"component":"component.storage","entit