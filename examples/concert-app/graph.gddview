same_key.rule.idempotency","edge.verify.scenario.foreign_cancel.rule.authorization","edge.verify.scenario.key_conflict.rule.idempotency","edge.verify.scenario.last_seat.rule.capacity","edge.verify.scenario.replay.rule.capacity","edge.verify.scenario.replay.rule.idempotency","edge.verify.scenario.replay_after_cancel.rule.capacity","edge.verify.scenario.replay_after_cancel.rule.idempotency","edge.verify.scenario.replay_after_cancel.rule.state_machine","edge.verify.scenario.reservation_missing.rule.authorization","edge.verify.scenario.reserve.rule.capacity","edge.verify.scenario.reserve.rule.state_machine","edge.verify.scenario.sold_out.rule.capacity","edge.verify.scenario.zero_capacity.rule.capacity"]},"nodes":{"action.cancel":{"behavior":"Validate identity and input first.\nAn absent reservation and another owner's reservation both yield ReservationNotFound.\nCheck ownership before returning data, including a retry for an already cancelled reservation.\nAtomically change reserved to cancelled so the reservation no longer occupies a seat.\nReturn cancelled unchanged; do not release a seat again.\nPreserve the old request key so a repeated reserve request cannot recreate the reservation.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"InvalidInput":["scenario.cancel_invalid"],"PersistenceUnavailable":["scenario.atomic_failure"],"ReservationNotFound":["scenario.reservation_missing","scenario.foreign_cancel"],"SessionChanged":["scenario.ui_session_change"],"Unauthenticated":["scenario.cancel_unauthenticated"]},"errors":{"InvalidInput":"Reject malformed input before any reservation mutation.","PersistenceUnavailable":"Rollback before returning failure; no partial effects or new key binding.","ReservationNotFound":"Return an error when the reservation does not exist; change no reservation.","SessionChanged":"At the HTTP boundary reject a stale presented identity before private reads or effects; the expectation never selects the authenticated principal.","Unauthenticated":"Reject before lookup or mutation when trusted authentication is absent."},"external_effects":[],"input":{"reservation_id":{"min_length":1,"type":"string"}},"output":{"properties":{"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["cancelled"]}},"required":["id","state"],"type":"object"},"postconditions":["An owned active reservation becomes cancelled atomically.","An already cancelled owned reservation remains cancelled.","Reject a stale browser identity expectation against the server-resolved session before reading personal data or applying effects."],"preconditions":["Validate authenticated identity and input before lookup or mutation."],"risks":{"atomicity":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.atomic_failure"]},"authorization":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.foreign_cancel"]},"boundaries":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.reservation_missing"]},"concurrency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.cancel_concurrent"]},"idempotency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.cancel","scenario.replay_after_cancel"]}}},"description":"The owner may cancel their reservation; repeating the request has no additional effect.","kind":"action","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.requirements"},{"purpose":"contract","source":"source.http"}]},"action.catalog":{"behavior":"Return fictional concerts with observational availability; this does not promise a subsequent booking.","contract":{"c