avior":"Return only this principal's complete reserved/cancelled history, active count and current nullable domain-owned limit.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"PersistenceUnavailable":["scenario.app.action.list_own_reservations.negative"],"SessionChanged":["scenario.ui_session_change"],"Unauthenticated":["scenario.app.action.list_own_reservations.negative"]},"errors":{"PersistenceUnavailable":"Return no partial private data.","SessionChanged":"At the HTTP boundary reject a stale presented identity before private reads or effects; the expectation never selects the authenticated principal.","Unauthenticated":"Reject before persistence lookup."},"external_effects":[],"input":{},"output":{"properties":{"active_count":{"minimum":0,"type":"integer"},"active_limit":{"minimum":1,"nullable":true,"type":"integer"},"reservations":{"items":{"properties":{"concert_id":{"min_length":1,"type":"string"},"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["reserved","cancelled"]}},"required":["id","concert_id","state"],"type":"object"},"type":"array"}},"required":["reservations","active_count","active_limit"],"type":"object"},"postconditions":["Return only this principal's complete reserved/cancelled history, active count and current nullable domain-owned limit.","Reject a stale browser identity expectation against the server-resolved session before reading personal data or applying effects.","Return active_limit=2 from the domain's single policy value."],"preconditions":["Validate the declared input and resolve any required session before exposing private data."],"risks":{"atomicity":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"authorization":{"rationale":"The negative scenario covers session/credential rejection.","relevant":true,"scenarios":["scenario.app.action.list_own_reservations.negative"]},"boundaries":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"concurrency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]},"idempotency":{"rationale":"This bounded operation has no additional transactional or idempotency obligation beyond its explicit contract.","relevant":false,"scenarios":[]}}},"description":"Return only this principal's complete reserved/cancelled history, active count and current nullable domain-owned limit.","kind":"action","maturity":"specified","source_refs":[{"purpose":"contract","source":"source.http"}]},"action.login":{"behavior":"Validate server-owned fictional credentials, establish an unpredictable opaque session, and return public principal information.","contract":{"context":{},"dependencies_complete":true,"effects_complete":true,"error_cases":{"InvalidCredentials":["scenario.app.action.login.negative"]},"errors":{"InvalidCredentials":"Establish no session and return no credential details."},"external_effects":["Issue an HttpOnly SameSite=Strict session cookie."],"input":{"password":{"min_length":1,"type":"string"},"username":{"min_length":1,"type":"string"}},"output":{"properties":{"principal":{"properties":{"id":{"min_length":1,"type":"string"},"name":{"min_length":1,"type":"string"}},"required":["id","name"],"type":"object"}},"required":["principal"],"type":"object"},"postconditions":["Validate server-owned fictional credentials, establish an unpredictable opaque session, and return public principal information."],"preconditions":["Validate the declared input and resolve any required session before exposing private data."],"risks":{"atomicity":{"rationale":"This bounded operation has no additional transactional or idempotency