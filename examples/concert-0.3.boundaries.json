  "components": {
    "component.api": {
      "boundary": {
        "responsibility": "Translate transport requests and forward trusted authentication context.",
        "rationale": "Keep transport changes separate from reservation and persistence decisions.",
        "excludes": [
          "Seat allocation and reservation lifecycle decisions.",
          "Physical persistence operations."
        ]
      },
      "interfaces_known": true,
      "public_contracts": []
    },
    "component.frontend": {
      "boundary": {
        "responsibility": "Present reservation interactions and their user-visible states.",
        "rationale": "Let presentation change while preserving the reservation operation contracts.",
        "excludes": [
          "Authoritative seat allocation and access-control decisions."
        ]
      },
      "interfaces_known": true,
      "public_contracts": []
    },
    "component.reservations": {
      "boundary": {
        "responsibility": "Own reservation rules, access control and transaction decisions.",
        "rationale": "Keep availability, atomicity and cancellation rules consistent behind one public interface.",
        "excludes": [
          "Transport request/response translation.",
          "Physical storage implementation."
        ]
      },
      "interfaces_known": true,
