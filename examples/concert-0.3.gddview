action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.cancel_once","id":"edge.verify.scenario.cancel_once.rule.capacity","relation":"verifies","to":"rule.capacity"},{"from":"scenario.cancel_once","id":"edge.verify.scenario.cancel_once.rule.state_machine","relation":"verifies","to":"rule.state_machine"},{"from":"scenario.cancel_concurrent","id":"edge.exercise.scenario.cancel_concurrent.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.cancel_concurrent","id":"edge.verify.scenario.cancel_concurrent.rule.capacity","relation":"verifies","to":"rule.capacity"},{"from":"scenario.cancel_concurrent","id":"edge.verify.scenario.cancel_concurrent.rule.idempotency","relation":"verifies","to":"rule.idempotency"},{"from":"scenario.cancel_unauthenticated","id":"edge.exercise.scenario.cancel_unauthenticated.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.cancel_invalid","id":"edge.exercise.scenario.cancel_invalid.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.reservation_missing","id":"edge.exercise.scenario.reservation_missing.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.reservation_missing","id":"edge.verify.scenario.reservation_missing.rule.authorization","relation":"verifies","to":"rule.authorization"},{"from":"action.reserve","id":"edge.effect.action.reserve.reads.entity.concert","relation":"reads","to":"entity.concert"},{"from":"action.reserve","id":"edge.effect.action.reserve.reads.entity.reservation","relation":"reads","to":"entity.reservation"},{"from":"action.reserve","id":"edge.effect.action.reserve.creates.entity.reservation","relation":"creates","to":"entity.reservation"},{"from":"action.cancel","id":"edge.effect.action.cancel.reads.entity.reservation","relation":"reads","to":"entity.reservation"},{"from":"action.cancel","id":"edge.effect.action.cancel.changes.entity.reservation","relation":"changes","to":"entity.reservation"},{"from":"screen.reserve","id":"edge.owner.screen.reserve","relation":"owned_by","to":"component.frontend"},{"from":"screen.reserve","id":"edge.screen.reserve.calls","relation":"calls","to":"action.reserve"},{"from":"component.api","id":"edge.community.component.api","relation":"member_of","to":"community.backend"},{"from":"component.reservations","id":"edge.community.component.reservations","relation":"member_of","to":"community.backend"},{"from":"component.storage","id":"edge.community.component.storage","relation":"member_of","to":"community.backend"},{"from":"entity.concert","id":"edge.community.entity.concert","relation":"member_of","to":"community.backend"},{"from":"entity.reservation","id":"edge.community.entity.reservation","relation":"member_of","to":"community.backend"},{"from":"action.reserve","id":"edge.community.action.reserve","relation":"member_of","to":"community.backend"},{"from":"action.cancel","id":"edge.community.action.cancel","relation":"member_of","to":"community.backend"},{"from":"machine.reservation","id":"edge.community.machine.reservation","relation":"member_of","to":"community.backend"},{"from":"component.frontend","id":"edge.community.component.frontend","relation":"member_of","to":"community.frontend"},{"from":"screen.reserve","id":"edge.community.screen.reserve","relation":"member_of","to":"community.frontend"},{"from":"action.reserve","id":"edge.feature.action.reserve","relation":"member_of","to":"community.reservation_feature"},{"from":"component.frontend","id":"edge.feature.component.frontend","relation":"member_of","to":"community.reservation_feature"}],"format":"gdd/0.3","nodes":{"action.cancel":{"behavior":"Validate identity and input first.\nAn absent reservation and another owner's reservation both yield ReservationNotFound.\nCheck ownership before returning data, including a retry for an already cancelled reservation.\nAtomically change reserved to cancelled so the reservation no longer occupies a seat.\nReturn cancelled unchanged; do not release a seat again.\nPreserve the old request key so a repeated reserve request cannot recreate the reservation.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"InvalidInput":["scenario.cancel_invalid"],"ReservationNotFound":["scenario.reservation_missing","scenario.foreign_cancel"],"Unauthenticated":["scenario.cancel_unauthenticated"]},"errors":{"InvalidInput":"Reject malformed input before any reservation mutation.","ReservationNotFound":"Return an error when the reservation does not exist; change no reservation.","Unauthenticated":"Reject before lookup or mutation when trusted authentication is absent."},"external_effects":[],"input":{"reservation_id":{"min_length":1,"type":"string"}},"output":{"properties":{"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["cancelled"]}},"required":["id","state"],"type":"object"},"postconditions":["An owned active reservation becomes cancelled atomically.","An already cancelled owned reservation remains cancelled."],"preconditions":["Validate authenticated identity and input before lookup or mutation."],"risks":{"atomicity":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.atomic_failure"]},"authorization":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.foreign_cancel"]},"boundaries":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.reservation_missing"]},"concurrency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.cancel_concurrent"]},"idempotency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.cancel","scenario.replay_after_cancel"]}}},"description":"The owner may cancel their reservation; repeating the request has no additional effect.","kind":"action","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"action.reserve":{"behavior":"Validate identity and input before lookup or mutation.\nThe request key is scoped to principal_id and action.reserve.\nBind a successful key to concert_id and reservation ID; reusing the key with another concert_id yields IdempotencyConflict.\nAn identical retry returns the same reservation ID and CURRENT state, including after cancellation, without new side effects.\nLook up an earlier success BEFORE checking new capacity; a full venue must not turn a successful retry into SoldOut.\nOnly a new key attempts to create a new reservation.\nReject a new reservation with SoldOut when the number of reservations in reserved equals capacity.\nKey uniqueness, capacity protection, creation and key binding must be part of the same atomic database operation or transaction.\nConcurrent transactions must produce a result equivalent to a valid sequential order under these rules; an unprotected check-then-insert is insufficient.\nA failed creation does not bind the request key and leaves no reservation.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"ConcertNotFound":["scenario.concert_missing"],"IdempotencyConflict":["scenario.key_conflict"],"InvalidInput":["scenario.reserve_invalid"],"SoldOut":["scenario.sold_out"],"Unauthenticated":["scenario.reserve_unauthenticated"]},"errors":{"ConcertNotFound":"Return an error and create no reservation when the concert does not exist.","IdempotencyConflict":"Reject a request key already bound to another concert; leave the existing reservation unchanged.","InvalidInput":"Reject malformed input before any reservation mutation.","SoldOut":"Return an error and create no reservation when no seat is available.","Unauthenticated":"Reject before lookup or mutation when trusted authentication is absent."},"external_effects":[],"input":{"concert_id":{"min_length":1,"type":"string"},"request_key":{"min_length":1,"type":"string"}},"output":{"properties":{"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["reserved","cancelled"]}},"required":["id","state"],"type":"object"},"postconditions":["A new reservation is created atomically only when capacity is available.","A successful repeated request returns its original reservation in its current state and creates no additional reservation."],"preconditions":["Validate authenticated identity and input before lookup or mutation."],"risks":{"atomicity":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.atomic_failure"]},"authorization":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.reserve_unauthenticated"]},"boundaries":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.zero_capacity","scenario.sold_out"]},"concurrency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.last_seat","scenario.concurrent_same_key"]},"idempotency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.replay","scenario.key_conflict"]}}},"description":"Reserve exactly one seat or retrieve an earlier successful result.","kind":"action","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"community.backend":{"description":"Backend view of the shared model.","kind":"community"},"community.frontend":{"description":"Frontend view of the shared model.","kind":"community"},"community.reservation_feature":{"description":"Cross-cutting reservation feature view; membership grants no permissions.","kind":"community"},"component.api":{"boundary":{"excludes":["Seat allocation and reservation lifecycle decisions.","Physical persistence operations."],"rationale":"Keep transport changes separate from reservation and persistence decisions.","responsibility":"Translate transport requests and forward trusted authentication context."},"description":"Validates transport input and forwards authenticated context.","interfaces":[],"kind":"component","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"component.frontend":{"boundary":{"excludes":["Authoritative seat allocation and access-control decisions."],"rationale":"Let presentation change while preserving the reservation operation contracts.","responsibility":"Present reservation interactions and their user-visible states."},"description":"Planned interface; a sketch without a technology stack.","interfaces":[],"kind":"component","maturity":"sketch"},"component.reservations":{"boundary":{"excludes":["Transport request/response translation.","Physical storage implementation."],"rationale":"Keep availability, atomicity and cancellation rules consistent behind one public interface.","responsibility":"Own reservation rules, access control and transaction decisions."},"description":"Owns reservation rules, access control and transaction boundaries.","interfaces":["action.reserve","action.cancel"],"kind":"component","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"component.storage":{"boundary":{"excludes":["Authentication and reservation policy decisions."],"rationale":"Isolate database-specific behavior behind the domain persistence boundary.","responsibility":"Implement persistence and transactions selected by the reservation component."},"description":"Database persistence adapter; contains no access-control decisions.","interfaces":[],"kind":"component","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"entity.concert":{"description":"A concert with a fixed nonnegative integer capacity.","fields":{"capacity":{"minimum":0,"type":"integer"},"id":{"min_length":1,"type":"string"}},"kind":"entity","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"entity.reservation":{"description":"One reserved seat with an owner and permanent request key.","fields":{"concert_id":{"min_length":1,"type":"string"},"id":{"min_length":1,"type":"string"},"owner_id":{"min_length":1,"type":"string"},"request_key":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["reserved","cancelled"]}},"kind":"entity","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"machine.reservation":{"annotations":{"gdd.notes":["absent is a modeling marker for a reservation that does not yet exist; it is never stored.","The state machine describes mutations. Validation, errors and idempotent return paths are defined in the action contracts.","cancelled is terminal for mutations but may still be read and returned during an authorized retry."]},"description":"Reservation mutation lifecycle; retries and errors follow the action contracts.","kind":"machine","machine":{"initial":"absent","states":["absent","reserved","cancelled"],"terminal":["cancelled"],"transitions":[{"effects":"Create a reservation with state=reserved and bind the request key atomically under capacity protection.","from":"absent","guard":"Authenticated user; existing concert; new request key; at least one available seat.","id":"transition.reserve","to":"reserved","trigger":"action.reserve"},{"effects":"Atomically change to cancelled; any materialized seat counter is updated within the same transaction.","from":"reserved","guard":"The authenticated user owns the reservation.","id":"transition.cancel","to":"cancelled","trigger":"action.cancel"}]},"maturity":"specified"},"rule.api_boundary":{"description":"The API module must not import the persistence module directly.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"architecture","constraint":{"from":"component.api","policy":"forbid","reach":"direct","relation":"imports","to":"component.storage"},"scope":"targeted","statement":"The API module must not import the persistence module directly.","verification":["static_import_analysis"]}},"rule.atomicity":{"description":"Errors before commit leave no partially completed mutation or request-key binding.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Errors before commit leave no partially completed mutation or request-key binding.","verification":["database_fault_injection_tests"]}},"rule.authorization":{"description":"Only the owner may cancel or receive reservation data; the request body must not determine identity.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Only the owner may cancel or receive reservation data; the request body must not determine identity.","verification":["authorization_tests"]}},"rule.capacity":{"description":"For each concert, 0 <= count(reservations with state=reserved) <= capacity after every committed mutation.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"invariant","scope":"targeted","statement":"For each concert, 0 <= count(reservations with state=reserved) <= capacity after every committed mutation.","verification":["database_concurrency_and_integration_tests"]}},"rule.design.dry":{"description":"Reservation and cancellation reuse one authoritative definition of each business rule; similar code alone does not require abstraction.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"dry","scope":"global","statement":"Reservation and cancellation reuse one authoritative definition of each business rule; similar code alone does not require abstraction.","verification":["design_review"]}},"rule.design.kiss":{"description":"Each layer and abstraction serves a current requirement; prefer the smallest clear implementation.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"kiss","scope":"global","statement":"Each layer and abstraction serves a current requirement; prefer the smallest clear implementation.","verification":["design_review"]}},"rule.design.modularity":{"description":"Components collaborate through public contracts and can change their internals without exposing them to consumers.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"modularity","scope":"global","statement":"Components collaborate through public contracts and can change their internals without exposing them to consumers.","verification":["design_review"]}},"rule.design.separation_of_concerns":{"description":"Transport, reservation decisions and physical storage remain with their responsible components.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"separation_of_concerns","scope":"global","statement":"Transport, reservation decisions and physical storage remain with their responsible components.","verification":["design_review"]}},"rule.idempotency":{"description":"Retries must not create extra reservations, reactivate cancelled reservations or release extra seats.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Retries must not create extra reservations, reactivate cancelled reservations or release extra seats.","verification":["integration_tests"]}},"rule.state_machine":{"description":"Mutating flows follow the state machine; cancelled reservation IDs cannot be reactivated.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Mutating flows follow the state machine; cancelled reservation IDs cannot be reactivated.","verification":["model_based_and_integration_tests"]}},"scenario.api_boundary":{"description":"The forbidden import must yield FAIL. An absent scan or unresolved mapping yields UNKNOWN, not PASS.","kind":"scenario","scenario":{"category":"architecture","given":"Component bindings point to the implemented project's modules.","then":"The forbidden import must yield FAIL. An absent scan or unresolved mapping yields UNKNOWN, not PASS.","when":"Extract the import graph; also insert a temporary direct API-to-storage import as a negative control."}},"scenario.atomic_failure":{"description":"Persistent state is unchanged after the failure; a successful retry applies the effect once. Also verify any counter and key binding.","kind":"scenario","scenario":{"category":"negative","given":"A valid reserve or cancel flow is ready for mutation.","then":"Persistent state is unchanged after the failure; a successful retry applies the effect once. Also verify any counter and key binding.","when":"The test adapter injects failures at relevant persistence boundaries before commit and lets the client retry."}},"scenario.cancel":{"description":"Same ID in cancelled; zero active reservations; available seats never exceed capacity.","kind":"scenario","scenario":{"category":"boundary","given":"A owns a reserved reservation for a concert with capacity=1.","then":"Same ID in cancelled; zero active reservations; available seats never exceed capacity.","when":"A cancels twice, including concurrent requests."}},"scenario.cancel_concurrent":{"description":"Both return the same cancelled ID; the seat is released only once.","kind":"scenario","scenario":{"category":"concurrency","given":"A ejer én reserved reservation.","then":"Both return the same cancelled ID; the seat is released only once.","when":"Two connections cancel concurrently."}},"scenario.cancel_invalid":{"description":"InvalidInput; no mutation.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; empty reservation_id.","then":"InvalidInput; no mutation.","when":"Cancel kaldes."}},"scenario.cancel_once":{"description":"The same ID is returned as cancelled; one seat is released.","kind":"scenario","scenario":{"category":"normal","given":"A owns a reserved reservation.","then":"The same ID is returned as cancelled; one seat is released.","when":"A cancels once."}},"scenario.cancel_unauthenticated":{"description":"Unauthenticated; no lookup or mutation.","kind":"scenario","scenario":{"category":"negative","given":"No server-authenticated principal.","then":"Unauthenticated; no lookup or mutation.","when":"Cancel kaldes."}},"scenario.concert_missing":{"description":"ConcertNotFound; the key is not bound.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; new key; concert does not exist.","then":"ConcertNotFound; the key is not bound.","when":"Reserve kaldes."}},"scenario.concurrent_same_key":{"description":"Both return the same reservation ID; exactly one reservation is created.","kind":"scenario","scenario":{"category":"concurrency","given":"C has capacity=2; A has not yet used K1.","then":"Both return the same reservation ID; exactly one reservation is created.","when":"A sends two identical reserve requests with K1 concurrently."}},"scenario.foreign_cancel":{"description":"ReservationNotFound; no change and no reservation data returned.","kind":"scenario","scenario":{"category":"negative","given":"A owns reservation R; B is authenticated as B.","then":"ReservationNotFound; no change and no reservation data returned.","when":"B attempts to cancel R, including a forged owner_id in the request body. Repeat for both reserved and cancelled states."}},"scenario.key_conflict":{"description":"IdempotencyConflict; no new reservation or capacity change in any concert.","kind":"scenario","scenario":{"category":"negative","given":"A has reserved concert C1 using K1.","then":"IdempotencyConflict; no new reservation or capacity change in any concert.","when":"A uses K1 for concert C2."}},"scenario.last_seat":{"description":"Exactly one reservation succeeds; the other yields SoldOut; at most one seat is occupied. Run against the selected database's actual transaction behavior.","kind":"scenario","scenario":{"category":"concurrency","given":"Concert C has one available seat; A and B each have a new request key.","then":"Exactly one reservation succeeds; the other yields SoldOut; at most one seat is occupied. Run against the selected database's actual transaction behavior.","when":"Two separate database connections attempt concurrent reservations with controlled overlap."}},"scenario.replay":{"description":"The same reservation ID is returned every time; no extra seat is occupied; no SoldOut on a retry.","kind":"scenario","scenario":{"category":"boundary","given":"C has capacity=1; A's reserve request with K1 succeeded and took the last seat.","then":"The same reservation ID is returned every time; no extra seat is occupied; no SoldOut on a retry.","when":"A repeats the same request several times, including concurrently."}},"scenario.replay_after_cancel":{"description":"K1 returns R in cancelled without mutation. K2 may create a new ID if capacity is available; R remains cancelled.","kind":"scenario","scenario":{"category":"boundary","given":"A reserved using K1 and then cancelled reservation R.","then":"K1 returns R in cancelled without mutation. K2 may create a new ID if capacity is available; R remains cancelled.","when":"A repeats the original reserve request with K1 and then creates a new one with K2."}},"scenario.reservation_missing":{"description":"ReservationNotFound without reservation data.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; reservation does not exist.","then":"ReservationNotFound without reservation data.","when":"Cancel kaldes."}},"scenario.reserve":{"description":"One reservation ID in reserved for A, and exactly one seat occupied.","kind":"scenario","scenario":{"category":"normal","given":"Concert C has capacity=1 and no reservations; user A is authenticated.","then":"One reservation ID in reserved for A, and exactly one seat occupied.","when":"A reserves C using key K1."}},"scenario.reserve_invalid":{"description":"InvalidInput; no mutation.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; empty concert_id or request_key.","then":"InvalidInput; no mutation.","when":"Reserve kaldes."}},"scenario.reserve_unauthenticated":{"description":"Unauthenticated; no lookup or mutation.","kind":"scenario","scenario":{"category":"negative","given":"No server-authenticated principal.","then":"Unauthenticated; no lookup or mutation.","when":"Reserve is called with otherwise valid input."}},"scenario.sold_out":{"description":"SoldOut; no mutation or key binding.","kind":"scenario","scenario":{"category":"negative","given":"The concert is full; the user has a new key.","then":"SoldOut; no mutation or key binding.","when":"Reserve kaldes."}},"scenario.zero_capacity":{"description":"SoldOut; zero active reservations.","kind":"scenario","scenario":{"category":"boundary","given":"The concert has capacity=0.","then":"SoldOut; zero active reservations.","when":"A valid new reservation is attempted."}},"screen.reserve":{"description":"Planned reservation screen; interaction and design are still missing.","design_refs":[{"purpose":"contract","selector":{"kind":"whole-document"},"source":"source.design"}],"kind":"screen","maturity":"sketch"}},"project":{"assumptions":["One seat per reservation. Multiple reservations with different request keys are allowed.","Concerts already exist, and capacity does not change in this example.","Identity comes from the server authentication layer, not a user_id in the request body.","Reservations do not expire automatically in this initial model.","Payment, ticket issuance, waiting lists and external events are outside this example.","Reservation history and successful request keys are retained; deletion is outside this example."],"goal":"A user can reserve and cancel a seat without overbooking.","id":"concert-reservations","scope":"A modular application and one transactional database; no microservices.","title":"Concert seat reservations"},"record_files":["concert-0.3.records.yaml"],"sources":{"source.design":{"format":"design-md/alpha","normative":false,"role":"design","title":"Planned frontend DESIGN.md; not written or verified","uri":"DESIGN.md"},"source.legacy":{"format":"gdd/0.1","normative":false,"revision":{"sha256":"f7b866db5d8e132b08044289ce35c82e65bef51d2833e0fb67806c3eebe682f5"},"role":"input","title":"Preserved gdd/0.1 intent for explicit migration","uri":"sources/legacy-concert.gdd.yaml"}}},"perspectives":{"format":"gdd-perspectives/0.1","spec_revision":"sha256:3a44421b96560abf0761f64e6d1a48db88a65f3f11f563ea134a33ffb1bf8d7b","advisory":true,"product_extension":null,"unsupported_extensions":[],"component_data_links":[{"component":"component.reservations","entity":"entity.concert","via":"owned_by","edge_ids":["edge.owner.entity.concert"]},{"component":"component.reservations","entity":"entity.concert","via":"reads","edge_ids":["edge.effect.action.reserve.reads.entity.concert","edge.owner.action.reserve"]},{"component":"component.reservations","entity":"entity.reservation","via":"changes","edge_ids":["edge.effect.action.cancel.changes.entity.reservation","edge.owner.action.cancel"]},{"component":"component.reservations","entity":"entity.reservation","via":"creates","edge_ids":["edge.effect.action.reserve.creates.entity.reservation","edge.owner.action.reserve"]},{"component":"component.reservations","entity":"entity.reservation","via":"owned_by","edge_ids":["edge.owner.entity.reservation"]},{"component":"component.reservations","entity":"entity.reservation","via":"reads","edge_ids":["edge.effect.action.cancel.reads.entity.reservation","edge.owner.action.cancel"]},{"component":"component.reservations","entity":"entity.reservation","via":"reads","edge_ids":["edge.effect.action.reserve.reads.entity.reservation","edge.owner.action.reserve"]},{"component":"component.storage","entity":"entity.concert","via":"stored_in","edge_ids":["edge.storage.entity.concert"]},{"component":"component.storage","entity":"entity.reservation","via":"stored_in","edge_ids":["edge.storage.entity.reservation"]}],"gaps":[],"views":{"journey":{"primary_node_ids":[],"cross_links":[],"shown":{"node_ids":[],"edge_ids":[]},"omitted":{"node_ids":["action.cancel","action.reserve","community.backend","community.frontend","community.reservation_feature","component.api","component.frontend","component.reservations","component.storage","entity.concert","entity.reservation","machine.reservation","rule.api_boundary","rule.atomicity","rule.authorization","rule.capacity","rule.design.dry","rule.design.kiss","rule.design.modularity","rule.design.separation_of_concerns","rule.idempotency","rule.state_machine","scenario.api_boundary","scenario.atomic_failure","scenario.cancel","scenario.cancel_concurrent","scenario.cancel_invalid","scenario.cancel_once","scenario.cancel_unauthenticated","scenario.concert_missing","scenario.concurrent_same_key","scenario.foreign_cancel","scenario.key_conflict","scenario.last_seat","scenario.replay","scenario.replay_after_cancel","scenario.reservation_missing","scenario.reserve","scenario.reserve_invalid","scenario.reserve_unauthenticated","scenario.sold_out","scenario.zero_capacity","screen.reserve"],"edge_ids":["edge.api_calls_cancel","edge.api_calls_reserve","edge.api_imports_reservations","edge.community.action.cancel","edge.community.action.reserve","edge.community.component.api","edge.community.component.frontend","edge.community.component.reservations","edge.community.component.storage","edge.community.entity.concert","edge.community.entity.reservation","edge.community.machine.reservation","edge.community.screen.reserve","edge.constraint.rule.api_boundary.component.api","edge.constraint.rule.api_boundary.component.storage","edge.constraint.rule.atomicity.action.cancel","edge.constraint.rule.atomicity.action.reserve","edge.constraint.rule.authorization.action.cancel","edge.constraint.rule.capacity.entity.concert","edge.constraint.rule.capacity.entity.reservation","edge.constraint.rule.idempotency.action.cancel","edge.constraint.rule.idempotency.action.reserve","edge.constraint.rule.state_machine.machine.reservation","edge.effect.action.cancel.changes.entity.reservation","edge.effect.action.cancel.reads.entity.reservation","edge.effect.action.reserve.creates.entity.reservation","edge.effect.action.reserve.reads.entity.concert","edge.effect.action.reserve.reads.entity.reservation","edge.exercise.scenario.atomic_failure.action.cancel","edge.exercise.scenario.atomic_failure.action.reserve","edge.exercise.scenario.cancel.action.cancel","edge.exercise.scenario.cancel.action.reserve","edge.exercise.scenario.cancel_concurrent.action.cancel","edge.exercise.scenario.cancel_invalid.action.cancel","edge.exercise.scenario.cancel_once.action.cancel","edge.exercise.scenario.cancel_unauthenticated.action.cancel","edge.exercise.scenario.concert_missing.action.reserve","edge.exercise.scenario.concurrent_same_key.action.reserve","edge.exercise.scenario.foreign_cancel.action.cancel","edge.exercise.scenario.key_conflict.action.reserve","edge.exercise.scenario.last_seat.action.reserve","edge.exercise.scenario.replay.action.reserve","edge.exercise.scenario.replay_after_cancel.action.cancel","edge.exercise.scenario.replay_after_cancel.action.reserve","edge.exercise.scenario.reservation_missing.action.cancel","edge.exercise.scenario.reserve.action.reserve","edge.exercise.scenario.reserve_invalid.action.reserve","edge.exercise.scenario.reserve_unauthenticated.action.reserve","edge.exercise.scenario.sold_out.action.reserve","edge.exercise.scenario.zero_capacity.action.reserve","edge.feature.action.reserve","edge.feature.component.frontend","edge.owner.action.cancel","edge.owner.action.reserve","edge.owner.entity.concert","edge.owner.entity.reservation","edge.owner.machine.reservation","edge.owner.screen.reserve","edge.reservations_imports_storage","edge.screen.reserve.calls","edge.state.machine.reservation","edge.storage.entity.concert","edge.storage.entity.reservation","edge.verify.scenario.api_boundary.rule.api_boundary","edge.verify.scenario.atomic_failure.rule.atomicity","edge.verify.scenario.cancel.rule.capacity","edge.verify.scenario.cancel.rule.idempotency","edge.verify.scenario.cancel.rule.state_machine","edge.verify.scenario.cancel_concurrent.rule.capacity","edge.verify.scenario.cancel_concurrent.rule.idempotency","edge.verify.scenario.cancel_once.rule.capacity","edge.verify.scenario.cancel_once.rule.state_machine","edge.verify.scenario.concurrent_same_key.rule.capacity","edge.verify.scenario.concurrent_same_key.rule.idempotency","edge.verify.scenario.foreign_cancel.rule.authorization","edge.verify.scenario.key_conflict.rule.idempotency","edge.verify.scenario.last_seat.rule.capacity","edge.verify.scenario.replay.rule.capacity","edge.verify.scenario.replay.rule.idempotency","edge.verify.scenario.replay_after_cancel.rule.capacity","edge.verify.scenario.replay_after_cancel.rule.idempotency","edge.verify.scenario.replay_after_cancel.rule.state_machine","edge.verify.scenario.reservation_missing.rule.authorization","edge.verify.scenario.reserve.rule.capacity","edge.verify.scenario.reserve.rule.state_machine","edge.verify.scenario.sold_out.rule.capacity","edge.verify.scenario.zero_capacity.rule.capacity"]},"nodes":{},"edges":[]},"components":{"primary_node_ids":["action.cancel","action.reserve","component.api","component.frontend","component.reservations","component.storage","screen.reserve"],"cross_links":[{"node_id":"entity.concert","views":["data"],"edge_ids":["edge.effect.action.reserve.reads.entity.concert","edge.owner.entity.concert","edge.storage.entity.concert"]},{"node_id":"entity.reservation","views":["data"],"edge_ids":["edge.effect.action.cancel.changes.entity.reservation","edge.effect.action.cancel.reads.entity.reservation","edge.effect.action.reserve.creates.entity.reservation","edge.effect.action.reserve.reads.entity.reservation","edge.owner.entity.reservation","edge.storage.entity.reservation"]},{"node_id":"machine.reservation","views":["data"],"edge_ids":["edge.owner.machine.reservation"]},{"node_id":"rule.api_boundary","views":["data"],"edge_ids":["edge.constraint.rule.api_boundary.component.api","edge.constraint.rule.api_boundary.component.storage"]},{"node_id":"rule.atomicity","views":["data"],"edge_ids":["edge.constraint.rule.atomicity.action.cancel","edge.constraint.rule.atomicity.action.reserve"]},{"node_id":"rule.authorization","views":["data"],"edge_ids":["edge.constraint.rule.authorization.action.cancel"]},{"node_id":"rule.idempotency","views":["data"],"edge_ids":["edge.constraint.rule.idempotency.action.cancel","edge.constraint.rule.idempotency.action.reserve"]}],"shown":{"node_ids":["action.cancel","action.reserve","community.backend","community.frontend","community.reservation_feature","component.api","component.frontend","component.reservations","component.storage","entity.concert","entity.reservation","machine.reservation","rule.api_boundary","rule.atomicity","rule.authorization","rule.idempotency","scenario.atomic_failure","scenario.cancel","scenario.cancel_concurrent","scenario.cancel_invalid","scenario.cancel_once","scenario.cancel_unauthenticated","scenario.concert_missing","scenario.concurrent_same_key","scenario.foreign_cancel","scenario.key_conflict","scenario.last_seat","scenario.replay","scenario.replay_after_cancel","scenario.reservation_missing","scenario.reserve","scenario.reserve_invalid","scenario.reserve_unauthenticated","scenario.sold_out","scenario.zero_capacity","screen.reserve"],"edge_ids":["edge.api_calls_cancel","edge.api_calls_reserve","edge.api_imports_reservations","edge.community.action.cancel","edge.community.action.reserve","edge.community.component.api","edge.community.component.frontend","edge.community.component.reservations","edge.community.component.storage","edge.community.screen.reserve","edge.constraint.rule.api_boundary.component.api","edge.constraint.rule.api_boundary.component.storage","edge.constraint.rule.atomicity.action.cancel","edge.constraint.rule.atomicity.action.reserve","edge.constraint.rule.authorization.action.cancel","edge.constraint.rule.idempotency.action.cancel","edge.constraint.rule.idempotency.action.reserve","edge.effect.action.cancel.changes.entity.reservation","edge.effect.action.cancel.reads.entity.reservation","edge.effect.action.reserve.creates.entity.reservation","edge.effect.action.reserve.reads.entity.concert","edge.effect.action.reserve.reads.entity.reservation","edge.exercise.scenario.atomic_failure.action.cancel","edge.exercise.scenario.atomic_failure.action.reserve","edge.exercise.scenario.cancel.action.cancel","edge.exercise.scenario.cancel.action.reserve","edge.exercise.scenario.cancel_concurrent.action.cancel","edge.exercise.scenario.cancel_invalid.action.cancel","edge.exercise.scenario.cancel_once.action.cancel","edge.exercise.scenario.cancel_unauthenticated.action.cancel","edge.exercise.scenario.concert_missing.action.reserve","edge.exercise.scenario.concurrent_same_key.action.reserve","edge.exercise.scenario.foreign_cancel.action.cancel","edge.exercise.scenario.key_conflict.action.reserve","edge.exercise.scenario.last_seat.action.reserve","edge.exercise.scenario.replay.action.reserve","edge.exercise.scenario.replay_after_cancel.action.cancel","edge.exercise.scenario.replay_after_cancel.action.reserve","edge.exercise.scenario.reservation_missing.action.cancel","edge.exercise.scenario.reserve.action.reserve","edge.exercise.scenario.reserve_invalid.action.reserve","edge.exercise.scenario.reserve_unauthenticated.action.reserve","edge.exercise.scenario.sold_out.action.reserve","edge.exercise.scenario.zero_capacity.action.reserve","edge.feature.action.reserve","edge.feature.component.frontend","edge.owner.action.cancel","edge.owner.action.reserve","edge.owner.entity.concert","edge.owner.entity.reservation","edge.owner.machine.reservation","edge.owner.screen.reserve","edge.reservations_imports_storage","edge.screen.reserve.calls","edge.storage.entity.concert","edge.storage.entity.reservation"]},"omitted":{"node_ids":["rule.capacity","rule.design.dry","rule.design.kiss","rule.design.modularity","rule.design.separation_of_concerns","rule.state_machine","scenario.api_boundary"],"edge_ids":["edge.community.entity.concert","edge.community.entity.reservation","edge.community.machine.reservation","edge.constraint.rule.capacity.entity.concert","edge.constraint.rule.capacity.entity.reservation","edge.constraint.rule.state_machine.machine.reservation","edge.state.machine.reservation","edge.verify.scenario.api_boundary.rule.api_boundary","edge.verify.scenario.atomic_failure.rule.atomicity","edge.verify.scenario.cancel.rule.capacity","edge.verify.scenario.cancel.rule.idempotency","edge.verify.scenario.cancel.rule.state_machine","edge.verify.scenario.cancel_concurrent.rule.capacity","edge.verify.scenario.cancel_concurrent.rule.idempotency","edge.verify.scenario.cancel_once.rule.capacity","edge.verify.scenario.cancel_once.rule.state_machine","edge.verify.scenario.concurrent_same_key.rule.capacity","edge.verify.scenario.concurrent_same_key.rule.idempotency","edge.verify.scenario.foreign_cancel.rule.authorization","edge.verify.scenario.key_conflict.rule.idempotency","edge.verify.scenario.last_seat.rule.capacity","edge.verify.scenario.replay.rule.capacity","edge.verify.scenario.replay.rule.idempotency","edge.verify.scenario.replay_after_cancel.rule.capacity","edge.verify.scenario.replay_after_cancel.rule.idempotency","edge.verify.scenario.replay_after_cancel.rule.state_machine","edge.verify.scenario.reservation_missing.rule.authorization","edge.verify.scenario.reserve.rule.capacity","edge.verify.scenario.reserve.rule.state_machine","edge.verify.scenario.sold_out.rule.capacity","edge.verify.scenario.zero_capacity.rule.capacity"]},"nodes":{"action.cancel":{"behavior":"Validate identity and input first.\nAn absent reservation and another owner's reservation both yield ReservationNotFound.\nCheck ownership before returning data, including a retry for an already cancelled reservation.\nAtomically change reserved to cancelled so the reservation no longer occupies a seat.\nReturn cancelled unchanged; do not release a seat again.\nPreserve the old request key so a repeated reserve request cannot recreate the reservation.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"InvalidInput":["scenario.cancel_invalid"],"ReservationNotFound":["scenario.reservation_missing","scenario.foreign_cancel"],"Unauthenticated":["scenario.cancel_unauthenticated"]},"errors":{"InvalidInput":"Reject malformed input before any reservation mutation.","ReservationNotFound":"Return an error when the reservation does not exist; change no reservation.","Unauthenticated":"Reject before lookup or mutation when trusted authentication is absent."},"external_effects":[],"input":{"reservation_id":{"min_length":1,"type":"string"}},"output":{"properties":{"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["cancelled"]}},"required":["id","state"],"type":"object"},"postconditions":["An owned active reservation becomes cancelled atomically.","An already cancelled owned reservation remains cancelled."],"preconditions":["Validate authenticated identity and input before lookup or mutation."],"risks":{"atomicity":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.atomic_failure"]},"authorization":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.foreign_cancel"]},"boundaries":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.reservation_missing"]},"concurrency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.cancel_concurrent"]},"idempotency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.cancel","scenario.replay_after_cancel"]}}},"description":"The owner may cancel their reservation; repeating the request has no additional effect.","kind":"action","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"action.reserve":{"behavior":"Validate identity and input before lookup or mutation.\nThe request key is scoped to principal_id and action.reserve.\nBind a successful key to concert_id and reservation ID; reusing the key with another concert_id yields IdempotencyConflict.\nAn identical retry returns the same reservation ID and CURRENT state, including after cancellation, without new side effects.\nLook up an earlier success BEFORE checking new capacity; a full venue must not turn a successful retry into SoldOut.\nOnly a new key attempts to create a new reservation.\nReject a new reservation with SoldOut when the number of reservations in reserved equals capacity.\nKey uniqueness, capacity protection, creation and key binding must be part of the same atomic database operation or transaction.\nConcurrent transactions must produce a result equivalent to a valid sequential order under these rules; an unprotected check-then-insert is insufficient.\nA failed creation does not bind the request key and leaves no reservation.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"ConcertNotFound":["scenario.concert_missing"],"IdempotencyConflict":["scenario.key_conflict"],"InvalidInput":["scenario.reserve_invalid"],"SoldOut":["scenario.sold_out"],"Unauthenticated":["scenario.reserve_unauthenticated"]},"errors":{"ConcertNotFound":"Return an error and create no reservation when the concert does not exist.","IdempotencyConflict":"Reject a request key already bound to another concert; leave the existing reservation unchanged.","InvalidInput":"Reject malformed input before any reservation mutation.","SoldOut":"Return an error and create no reservation when no seat is available.","Unauthenticated":"Reject before lookup or mutation when trusted authentication is absent."},"external_effects":[],"input":{"concert_id":{"min_length":1,"type":"string"},"request_key":{"min_length":1,"type":"string"}},"output":{"properties":{"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["reserved","cancelled"]}},"required":["id","state"],"type":"object"},"postconditions":["A new reservation is created atomically only when capacity is available.","A successful repeated request returns its original reservation in its current state and creates no additional reservation."],"preconditions":["Validate authenticated identity and input before lookup or mutation."],"risks":{"atomicity":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.atomic_failure"]},"authorization":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.reserve_unauthenticated"]},"boundaries":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.zero_capacity","scenario.sold_out"]},"concurrency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.last_seat","scenario.concurrent_same_key"]},"idempotency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.replay","scenario.key_conflict"]}}},"description":"Reserve exactly one seat or retrieve an earlier successful result.","kind":"action","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"community.backend":{"description":"Backend view of the shared model.","kind":"community"},"community.frontend":{"description":"Frontend view of the shared model.","kind":"community"},"community.reservation_feature":{"description":"Cross-cutting reservation feature view; membership grants no permissions.","kind":"community"},"component.api":{"boundary":{"excludes":["Seat allocation and reservation lifecycle decisions.","Physical persistence operations."],"rationale":"Keep transport changes separate from reservation and persistence decisions.","responsibility":"Translate transport requests and forward trusted authentication context."},"description":"Validates transport input and forwards authenticated context.","interfaces":[],"kind":"component","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"component.frontend":{"boundary":{"excludes":["Authoritative seat allocation and access-control decisions."],"rationale":"Let presentation change while preserving the reservation operation contracts.","responsibility":"Present reservation interactions and their user-visible states."},"description":"Planned interface; a sketch without a technology stack.","interfaces":[],"kind":"component","maturity":"sketch"},"component.reservations":{"boundary":{"excludes":["Transport request/response translation.","Physical storage implementation."],"rationale":"Keep availability, atomicity and cancellation rules consistent behind one public interface.","responsibility":"Own reservation rules, access control and transaction decisions."},"description":"Owns reservation rules, access control and transaction boundaries.","interfaces":["action.reserve","action.cancel"],"kind":"component","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"component.storage":{"boundary":{"excludes":["Authentication and reservation policy decisions."],"rationale":"Isolate database-specific behavior behind the domain persistence boundary.","responsibility":"Implement persistence and transactions selected by the reservation component."},"description":"Database persistence adapter; contains no access-control decisions.","interfaces":[],"kind":"component","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"entity.concert":{"description":"A concert with a fixed nonnegative integer capacity.","fields":{"capacity":{"minimum":0,"type":"integer"},"id":{"min_length":1,"type":"string"}},"kind":"entity","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"entity.reservation":{"description":"One reserved seat with an owner and permanent request key.","fields":{"concert_id":{"min_length":1,"type":"string"},"id":{"min_length":1,"type":"string"},"owner_id":{"min_length":1,"type":"string"},"request_key":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["reserved","cancelled"]}},"kind":"entity","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"machine.reservation":{"annotations":{"gdd.notes":["absent is a modeling marker for a reservation that does not yet exist; it is never stored.","The state machine describes mutations. Validation, errors and idempotent return paths are defined in the action contracts.","cancelled is terminal for mutations but may still be read and returned during an authorized retry."]},"description":"Reservation mutation lifecycle; retries and errors follow the action contracts.","kind":"machine","machine":{"initial":"absent","states":["absent","reserved","cancelled"],"terminal":["cancelled"],"transitions":[{"effects":"Create a reservation with state=reserved and bind the request key atomically under capacity protection.","from":"absent","guard":"Authenticated user; existing concert; new request key; at least one available seat.","id":"transition.reserve","to":"reserved","trigger":"action.reserve"},{"effects":"Atomically change to cancelled; any materialized seat counter is updated within the same transaction.","from":"reserved","guard":"The authenticated user owns the reservation.","id":"transition.cancel","to":"cancelled","trigger":"action.cancel"}]},"maturity":"specified"},"rule.api_boundary":{"description":"The API module must not import the persistence module directly.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"architecture","constraint":{"from":"component.api","policy":"forbid","reach":"direct","relation":"imports","to":"component.storage"},"scope":"targeted","statement":"The API module must not import the persistence module directly.","verification":["static_import_analysis"]}},"rule.atomicity":{"description":"Errors before commit leave no partially completed mutation or request-key binding.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Errors before commit leave no partially completed mutation or request-key binding.","verification":["database_fault_injection_tests"]}},"rule.authorization":{"description":"Only the owner may cancel or receive reservation data; the request body must not determine identity.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Only the owner may cancel or receive reservation data; the request body must not determine identity.","verification":["authorization_tests"]}},"rule.idempotency":{"description":"Retries must not create extra reservations, reactivate cancelled reservations or release extra seats.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Retries must not create extra reservations, reactivate cancelled reservations or release extra seats.","verification":["integration_tests"]}},"scenario.atomic_failure":{"description":"Persistent state is unchanged after the failure; a successful retry applies the effect once. Also verify any counter and key binding.","kind":"scenario","scenario":{"category":"negative","given":"A valid reserve or cancel flow is ready for mutation.","then":"Persistent state is unchanged after the failure; a successful retry applies the effect once. Also verify any counter and key binding.","when":"The test adapter injects failures at relevant persistence boundaries before commit and lets the client retry."}},"scenario.cancel":{"description":"Same ID in cancelled; zero active reservations; available seats never exceed capacity.","kind":"scenario","scenario":{"category":"boundary","given":"A owns a reserved reservation for a concert with capacity=1.","then":"Same ID in cancelled; zero active reservations; available seats never exceed capacity.","when":"A cancels twice, including concurrent requests."}},"scenario.cancel_concurrent":{"description":"Both return the same cancelled ID; the seat is released only once.","kind":"scenario","scenario":{"category":"concurrency","given":"A ejer én reserved reservation.","then":"Both return the same cancelled ID; the seat is released only once.","when":"Two connections cancel concurrently."}},"scenario.cancel_invalid":{"description":"InvalidInput; no mutation.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; empty reservation_id.","then":"InvalidInput; no mutation.","when":"Cancel kaldes."}},"scenario.cancel_once":{"description":"The same ID is returned as cancelled; one seat is released.","kind":"scenario","scenario":{"category":"normal","given":"A owns a reserved reservation.","then":"The same ID is returned as cancelled; one seat is released.","when":"A cancels once."}},"scenario.cancel_unauthenticated":{"description":"Unauthenticated; no lookup or mutation.","kind":"scenario","scenario":{"category":"negative","given":"No server-authenticated principal.","then":"Unauthenticated; no lookup or mutation.","when":"Cancel kaldes."}},"scenario.concert_missing":{"description":"ConcertNotFound; the key is not bound.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; new key; concert does not exist.","then":"ConcertNotFound; the key is not bound.","when":"Reserve kaldes."}},"scenario.concurrent_same_key":{"description":"Both return the same reservation ID; exactly one reservation is created.","kind":"scenario","scenario":{"category":"concurrency","given":"C has capacity=2; A has not yet used K1.","then":"Both return the same reservation ID; exactly one reservation is created.","when":"A sends two identical reserve requests with K1 concurrently."}},"scenario.foreign_cancel":{"description":"ReservationNotFound; no change and no reservation data returned.","kind":"scenario","scenario":{"category":"negative","given":"A owns reservation R; B is authenticated as B.","then":"ReservationNotFound; no change and no reservation data returned.","when":"B attempts to cancel R, including a forged owner_id in the request body. Repeat for both reserved and cancelled states."}},"scenario.key_conflict":{"description":"IdempotencyConflict; no new reservation or capacity change in any concert.","kind":"scenario","scenario":{"category":"negative","given":"A has reserved concert C1 using K1.","then":"IdempotencyConflict; no new reservation or capacity change in any concert.","when":"A uses K1 for concert C2."}},"scenario.last_seat":{"description":"Exactly one reservation succeeds; the other yields SoldOut; at most one seat is occupied. Run against the selected database's actual transaction behavior.","kind":"scenario","scenario":{"category":"concurrency","given":"Concert C has one available seat; A and B each have a new request key.","then":"Exactly one reservation succeeds; the other yields SoldOut; at most one seat is occupied. Run against the selected database's actual transaction behavior.","when":"Two separate database connections attempt concurrent reservations with controlled overlap."}},"scenario.replay":{"description":"The same reservation ID is returned every time; no extra seat is occupied; no SoldOut on a retry.","kind":"scenario","scenario":{"category":"boundary","given":"C has capacity=1; A's reserve request with K1 succeeded and took the last seat.","then":"The same reservation ID is returned every time; no extra seat is occupied; no SoldOut on a retry.","when":"A repeats the same request several times, including concurrently."}},"scenario.replay_after_cancel":{"description":"K1 returns R in cancelled without mutation. K2 may create a new ID if capacity is available; R remains cancelled.","kind":"scenario","scenario":{"category":"boundary","given":"A reserved using K1 and then cancelled reservation R.","then":"K1 returns R in cancelled without mutation. K2 may create a new ID if capacity is available; R remains cancelled.","when":"A repeats the original reserve request with K1 and then creates a new one with K2."}},"scenario.reservation_missing":{"description":"ReservationNotFound without reservation data.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; reservation does not exist.","then":"ReservationNotFound without reservation data.","when":"Cancel kaldes."}},"scenario.reserve":{"description":"One reservation ID in reserved for A, and exactly one seat occupied.","kind":"scenario","scenario":{"category":"normal","given":"Concert C has capacity=1 and no reservations; user A is authenticated.","then":"One reservation ID in reserved for A, and exactly one seat occupied.","when":"A reserves C using key K1."}},"scenario.reserve_invalid":{"description":"InvalidInput; no mutation.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; empty concert_id or request_key.","then":"InvalidInput; no mutation.","when":"Reserve kaldes."}},"scenario.reserve_unauthenticated":{"description":"Unauthenticated; no lookup or mutation.","kind":"scenario","scenario":{"category":"negative","given":"No server-authenticated principal.","then":"Unauthenticated; no lookup or mutation.","when":"Reserve is called with otherwise valid input."}},"scenario.sold_out":{"description":"SoldOut; no mutation or key binding.","kind":"scenario","scenario":{"category":"negative","given":"The concert is full; the user has a new key.","then":"SoldOut; no mutation or key binding.","when":"Reserve kaldes."}},"scenario.zero_capacity":{"description":"SoldOut; zero active reservations.","kind":"scenario","scenario":{"category":"boundary","given":"The concert has capacity=0.","then":"SoldOut; zero active reservations.","when":"A valid new reservation is attempted."}},"screen.reserve":{"description":"Planned reservation screen; interaction and design are still missing.","design_refs":[{"purpose":"contract","selector":{"kind":"whole-document"},"source":"source.design"}],"kind":"screen","maturity":"sketch"}},"edges":[{"from":"component.api","id":"edge.api_calls_cancel","relation":"calls","to":"action.cancel"},{"from":"component.api","id":"edge.api_calls_reserve","relation":"calls","to":"action.reserve"},{"from":"component.api","id":"edge.api_imports_reservations","relation":"imports","to":"component.reservations"},{"from":"action.cancel","id":"edge.community.action.cancel","relation":"member_of","to":"community.backend"},{"from":"action.reserve","id":"edge.community.action.reserve","relation":"member_of","to":"community.backend"},{"from":"component.api","id":"edge.community.component.api","relation":"member_of","to":"community.backend"},{"from":"component.frontend","id":"edge.community.component.frontend","relation":"member_of","to":"community.frontend"},{"from":"component.reservations","id":"edge.community.component.reservations","relation":"member_of","to":"community.backend"},{"from":"component.storage","id":"edge.community.component.storage","relation":"member_of","to":"community.backend"},{"from":"screen.reserve","id":"edge.community.screen.reserve","relation":"member_of","to":"community.frontend"},{"from":"rule.api_boundary","id":"edge.constraint.rule.api_boundary.component.api","relation":"constrains","to":"component.api"},{"from":"rule.api_boundary","id":"edge.constraint.rule.api_boundary.component.storage","relation":"constrains","to":"component.storage"},{"from":"rule.atomicity","id":"edge.constraint.rule.atomicity.action.cancel","relation":"constrains","to":"action.cancel"},{"from":"rule.atomicity","id":"edge.constraint.rule.atomicity.action.reserve","relation":"constrains","to":"action.reserve"},{"from":"rule.authorization","id":"edge.constraint.rule.authorization.action.cancel","relation":"constrains","to":"action.cancel"},{"from":"rule.idempotency","id":"edge.constraint.rule.idempotency.action.cancel","relation":"constrains","to":"action.cancel"},{"from":"rule.idempotency","id":"edge.constraint.rule.idempotency.action.reserve","relation":"constrains","to":"action.reserve"},{"from":"action.cancel","id":"edge.effect.action.cancel.changes.entity.reservation","relation":"changes","to":"entity.reservation"},{"from":"action.cancel","id":"edge.effect.action.cancel.reads.entity.reservation","relation":"reads","to":"entity.reservation"},{"from":"action.reserve","id":"edge.effect.action.reserve.creates.entity.reservation","relation":"creates","to":"entity.reservation"},{"from":"action.reserve","id":"edge.effect.action.reserve.reads.entity.concert","relation":"reads","to":"entity.concert"},{"from":"action.reserve","id":"edge.effect.action.reserve.reads.entity.reservation","relation":"reads","to":"entity.reservation"},{"from":"scenario.atomic_failure","id":"edge.exercise.scenario.atomic_failure.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.atomic_failure","id":"edge.exercise.scenario.atomic_failure.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.cancel","id":"edge.exercise.scenario.cancel.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.cancel","id":"edge.exercise.scenario.cancel.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.cancel_concurrent","id":"edge.exercise.scenario.cancel_concurrent.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.cancel_invalid","id":"edge.exercise.scenario.cancel_invalid.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.cancel_once","id":"edge.exercise.scenario.cancel_once.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.cancel_unauthenticated","id":"edge.exercise.scenario.cancel_unauthenticated.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.concert_missing","id":"edge.exercise.scenario.concert_missing.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.concurrent_same_key","id":"edge.exercise.scenario.concurrent_same_key.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.foreign_cancel","id":"edge.exercise.scenario.foreign_cancel.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.key_conflict","id":"edge.exercise.scenario.key_conflict.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.last_seat","id":"edge.exercise.scenario.last_seat.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.replay","id":"edge.exercise.scenario.replay.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.replay_after_cancel","id":"edge.exercise.scenario.replay_after_cancel.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.replay_after_cancel","id":"edge.exercise.scenario.replay_after_cancel.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.reservation_missing","id":"edge.exercise.scenario.reservation_missing.action.cancel","relation":"exercises","to":"action.cancel"},{"from":"scenario.reserve","id":"edge.exercise.scenario.reserve.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.reserve_invalid","id":"edge.exercise.scenario.reserve_invalid.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.reserve_unauthenticated","id":"edge.exercise.scenario.reserve_unauthenticated.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.sold_out","id":"edge.exercise.scenario.sold_out.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"scenario.zero_capacity","id":"edge.exercise.scenario.zero_capacity.action.reserve","relation":"exercises","to":"action.reserve"},{"from":"action.reserve","id":"edge.feature.action.reserve","relation":"member_of","to":"community.reservation_feature"},{"from":"component.frontend","id":"edge.feature.component.frontend","relation":"member_of","to":"community.reservation_feature"},{"from":"action.cancel","id":"edge.owner.action.cancel","relation":"owned_by","to":"component.reservations"},{"from":"action.reserve","id":"edge.owner.action.reserve","relation":"owned_by","to":"component.reservations"},{"from":"entity.concert","id":"edge.owner.entity.concert","relation":"owned_by","to":"component.reservations"},{"from":"entity.reservation","id":"edge.owner.entity.reservation","relation":"owned_by","to":"component.reservations"},{"from":"machine.reservation","id":"edge.owner.machine.reservation","relation":"owned_by","to":"component.reservations"},{"from":"screen.reserve","id":"edge.owner.screen.reserve","relation":"owned_by","to":"component.frontend"},{"from":"component.reservations","id":"edge.reservations_imports_storage","relation":"imports","to":"component.storage"},{"from":"screen.reserve","id":"edge.screen.reserve.calls","relation":"calls","to":"action.reserve"},{"from":"entity.concert","id":"edge.storage.entity.concert","relation":"stored_in","to":"component.storage"},{"from":"entity.reservation","id":"edge.storage.entity.reservation","relation":"stored_in","to":"component.storage"}]},"data":{"primary_node_ids":["entity.concert","entity.reservation","machine.reservation","rule.api_boundary","rule.atomicity","rule.authorization","rule.capacity","rule.design.dry","rule.design.kiss","rule.design.modularity","rule.design.separation_of_concerns","rule.idempotency","rule.state_machine"],"cross_links":[{"node_id":"action.cancel","views":["components"],"edge_ids":["edge.constraint.rule.atomicity.action.cancel","edge.constraint.rule.authorization.action.cancel","edge.constraint.rule.idempotency.action.cancel","edge.effect.action.cancel.changes.entity.reservation","edge.effect.action.cancel.reads.entity.reservation"]},{"node_id":"action.reserve","views":["components"],"edge_ids":["edge.constraint.rule.atomicity.action.reserve","edge.constraint.rule.idempotency.action.reserve","edge.effect.action.reserve.creates.entity.reservation","edge.effect.action.reserve.reads.entity.concert","edge.effect.action.reserve.reads.entity.reservation"]},{"node_id":"component.api","views":["components"],"edge_ids":["edge.constraint.rule.api_boundary.component.api"]},{"node_id":"component.reservations","views":["components"],"edge_ids":["edge.owner.entity.concert","edge.owner.entity.reservation","edge.owner.machine.reservation"]},{"node_id":"component.storage","views":["components"],"edge_ids":["edge.constraint.rule.api_boundary.component.storage","edge.storage.entity.concert","edge.storage.entity.reservation"]}],"shown":{"node_ids":["action.cancel","action.reserve","community.backend","component.api","component.reservations","component.storage","entity.concert","entity.reservation","machine.reservation","rule.api_boundary","rule.atomicity","rule.authorization","rule.capacity","rule.design.dry","rule.design.kiss","rule.design.modularity","rule.design.separation_of_concerns","rule.idempotency","rule.state_machine","scenario.api_boundary","scenario.atomic_failure","scenario.cancel","scenario.cancel_concurrent","scenario.cancel_once","scenario.concurrent_same_key","scenario.foreign_cancel","scenario.key_conflict","scenario.last_seat","scenario.replay","scenario.replay_after_cancel","scenario.reservation_missing","scenario.reserve","scenario.sold_out","scenario.zero_capacity"],"edge_ids":["edge.community.entity.concert","edge.community.entity.reservation","edge.community.machine.reservation","edge.constraint.rule.api_boundary.component.api","edge.constraint.rule.api_boundary.component.storage","edge.constraint.rule.atomicity.action.cancel","edge.constraint.rule.atomicity.action.reserve","edge.constraint.rule.authorization.action.cancel","edge.constraint.rule.capacity.entity.concert","edge.constraint.rule.capacity.entity.reservation","edge.constraint.rule.idempotency.action.cancel","edge.constraint.rule.idempotency.action.reserve","edge.constraint.rule.state_machine.machine.reservation","edge.effect.action.cancel.changes.entity.reservation","edge.effect.action.cancel.reads.entity.reservation","edge.effect.action.reserve.creates.entity.reservation","edge.effect.action.reserve.reads.entity.concert","edge.effect.action.reserve.reads.entity.reservation","edge.owner.entity.concert","edge.owner.entity.reservation","edge.owner.machine.reservation","edge.state.machine.reservation","edge.storage.entity.concert","edge.storage.entity.reservation","edge.verify.scenario.api_boundary.rule.api_boundary","edge.verify.scenario.atomic_failure.rule.atomicity","edge.verify.scenario.cancel.rule.capacity","edge.verify.scenario.cancel.rule.idempotency","edge.verify.scenario.cancel.rule.state_machine","edge.verify.scenario.cancel_concurrent.rule.capacity","edge.verify.scenario.cancel_concurrent.rule.idempotency","edge.verify.scenario.cancel_once.rule.capacity","edge.verify.scenario.cancel_once.rule.state_machine","edge.verify.scenario.concurrent_same_key.rule.capacity","edge.verify.scenario.concurrent_same_key.rule.idempotency","edge.verify.scenario.foreign_cancel.rule.authorization","edge.verify.scenario.key_conflict.rule.idempotency","edge.verify.scenario.last_seat.rule.capacity","edge.verify.scenario.replay.rule.capacity","edge.verify.scenario.replay.rule.idempotency","edge.verify.scenario.replay_after_cancel.rule.capacity","edge.verify.scenario.replay_after_cancel.rule.idempotency","edge.verify.scenario.replay_after_cancel.rule.state_machine","edge.verify.scenario.reservation_missing.rule.authorization","edge.verify.scenario.reserve.rule.capacity","edge.verify.scenario.reserve.rule.state_machine","edge.verify.scenario.sold_out.rule.capacity","edge.verify.scenario.zero_capacity.rule.capacity"]},"omitted":{"node_ids":["community.frontend","community.reservation_feature","component.frontend","scenario.cancel_invalid","scenario.cancel_unauthenticated","scenario.concert_missing","scenario.reserve_invalid","scenario.reserve_unauthenticated","screen.reserve"],"edge_ids":["edge.api_calls_cancel","edge.api_calls_reserve","edge.api_imports_reservations","edge.community.action.cancel","edge.community.action.reserve","edge.community.component.api","edge.community.component.frontend","edge.community.component.reservations","edge.community.component.storage","edge.community.screen.reserve","edge.exercise.scenario.atomic_failure.action.cancel","edge.exercise.scenario.atomic_failure.action.reserve","edge.exercise.scenario.cancel.action.cancel","edge.exercise.scenario.cancel.action.reserve","edge.exercise.scenario.cancel_concurrent.action.cancel","edge.exercise.scenario.cancel_invalid.action.cancel","edge.exercise.scenario.cancel_once.action.cancel","edge.exercise.scenario.cancel_unauthenticated.action.cancel","edge.exercise.scenario.concert_missing.action.reserve","edge.exercise.scenario.concurrent_same_key.action.reserve","edge.exercise.scenario.foreign_cancel.action.cancel","edge.exercise.scenario.key_conflict.action.reserve","edge.exercise.scenario.last_seat.action.reserve","edge.exercise.scenario.replay.action.reserve","edge.exercise.scenario.replay_after_cancel.action.cancel","edge.exercise.scenario.replay_after_cancel.action.reserve","edge.exercise.scenario.reservation_missing.action.cancel","edge.exercise.scenario.reserve.action.reserve","edge.exercise.scenario.reserve_invalid.action.reserve","edge.exercise.scenario.reserve_unauthenticated.action.reserve","edge.exercise.scenario.sold_out.action.reserve","edge.exercise.scenario.zero_capacity.action.reserve","edge.feature.action.reserve","edge.feature.component.frontend","edge.owner.action.cancel","edge.owner.action.reserve","edge.owner.screen.reserve","edge.reservations_imports_storage","edge.screen.reserve.calls"]},"nodes":{"action.cancel":{"behavior":"Validate identity and input first.\nAn absent reservation and another owner's reservation both yield ReservationNotFound.\nCheck ownership before returning data, including a retry for an already cancelled reservation.\nAtomically change reserved to cancelled so the reservation no longer occupies a seat.\nReturn cancelled unchanged; do not release a seat again.\nPreserve the old request key so a repeated reserve request cannot recreate the reservation.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"InvalidInput":["scenario.cancel_invalid"],"ReservationNotFound":["scenario.reservation_missing","scenario.foreign_cancel"],"Unauthenticated":["scenario.cancel_unauthenticated"]},"errors":{"InvalidInput":"Reject malformed input before any reservation mutation.","ReservationNotFound":"Return an error when the reservation does not exist; change no reservation.","Unauthenticated":"Reject before lookup or mutation when trusted authentication is absent."},"external_effects":[],"input":{"reservation_id":{"min_length":1,"type":"string"}},"output":{"properties":{"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["cancelled"]}},"required":["id","state"],"type":"object"},"postconditions":["An owned active reservation becomes cancelled atomically.","An already cancelled owned reservation remains cancelled."],"preconditions":["Validate authenticated identity and input before lookup or mutation."],"risks":{"atomicity":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.atomic_failure"]},"authorization":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.foreign_cancel"]},"boundaries":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.reservation_missing"]},"concurrency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.cancel_concurrent"]},"idempotency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.cancel","scenario.replay_after_cancel"]}}},"description":"The owner may cancel their reservation; repeating the request has no additional effect.","kind":"action","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"action.reserve":{"behavior":"Validate identity and input before lookup or mutation.\nThe request key is scoped to principal_id and action.reserve.\nBind a successful key to concert_id and reservation ID; reusing the key with another concert_id yields IdempotencyConflict.\nAn identical retry returns the same reservation ID and CURRENT state, including after cancellation, without new side effects.\nLook up an earlier success BEFORE checking new capacity; a full venue must not turn a successful retry into SoldOut.\nOnly a new key attempts to create a new reservation.\nReject a new reservation with SoldOut when the number of reservations in reserved equals capacity.\nKey uniqueness, capacity protection, creation and key binding must be part of the same atomic database operation or transaction.\nConcurrent transactions must produce a result equivalent to a valid sequential order under these rules; an unprotected check-then-insert is insufficient.\nA failed creation does not bind the request key and leaves no reservation.","contract":{"context":{"principal_id":{"min_length":1,"origin":"authenticated_context","type":"string"}},"dependencies_complete":true,"effects_complete":true,"error_cases":{"ConcertNotFound":["scenario.concert_missing"],"IdempotencyConflict":["scenario.key_conflict"],"InvalidInput":["scenario.reserve_invalid"],"SoldOut":["scenario.sold_out"],"Unauthenticated":["scenario.reserve_unauthenticated"]},"errors":{"ConcertNotFound":"Return an error and create no reservation when the concert does not exist.","IdempotencyConflict":"Reject a request key already bound to another concert; leave the existing reservation unchanged.","InvalidInput":"Reject malformed input before any reservation mutation.","SoldOut":"Return an error and create no reservation when no seat is available.","Unauthenticated":"Reject before lookup or mutation when trusted authentication is absent."},"external_effects":[],"input":{"concert_id":{"min_length":1,"type":"string"},"request_key":{"min_length":1,"type":"string"}},"output":{"properties":{"id":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["reserved","cancelled"]}},"required":["id","state"],"type":"object"},"postconditions":["A new reservation is created atomically only when capacity is available.","A successful repeated request returns its original reservation in its current state and creates no additional reservation."],"preconditions":["Validate authenticated identity and input before lookup or mutation."],"risks":{"atomicity":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.atomic_failure"]},"authorization":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.reserve_unauthenticated"]},"boundaries":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.zero_capacity","scenario.sold_out"]},"concurrency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.last_seat","scenario.concurrent_same_key"]},"idempotency":{"rationale":"The contract covers this risk; the scenarios are planned checks.","relevant":true,"scenarios":["scenario.replay","scenario.key_conflict"]}}},"description":"Reserve exactly one seat or retrieve an earlier successful result.","kind":"action","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"community.backend":{"description":"Backend view of the shared model.","kind":"community"},"component.api":{"boundary":{"excludes":["Seat allocation and reservation lifecycle decisions.","Physical persistence operations."],"rationale":"Keep transport changes separate from reservation and persistence decisions.","responsibility":"Translate transport requests and forward trusted authentication context."},"description":"Validates transport input and forwards authenticated context.","interfaces":[],"kind":"component","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"component.reservations":{"boundary":{"excludes":["Transport request/response translation.","Physical storage implementation."],"rationale":"Keep availability, atomicity and cancellation rules consistent behind one public interface.","responsibility":"Own reservation rules, access control and transaction decisions."},"description":"Owns reservation rules, access control and transaction boundaries.","interfaces":["action.reserve","action.cancel"],"kind":"component","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"component.storage":{"boundary":{"excludes":["Authentication and reservation policy decisions."],"rationale":"Isolate database-specific behavior behind the domain persistence boundary.","responsibility":"Implement persistence and transactions selected by the reservation component."},"description":"Database persistence adapter; contains no access-control decisions.","interfaces":[],"kind":"component","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"entity.concert":{"description":"A concert with a fixed nonnegative integer capacity.","fields":{"capacity":{"minimum":0,"type":"integer"},"id":{"min_length":1,"type":"string"}},"kind":"entity","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"entity.reservation":{"description":"One reserved seat with an owner and permanent request key.","fields":{"concert_id":{"min_length":1,"type":"string"},"id":{"min_length":1,"type":"string"},"owner_id":{"min_length":1,"type":"string"},"request_key":{"min_length":1,"type":"string"},"state":{"type":"enum","values":["reserved","cancelled"]}},"kind":"entity","maturity":"specified","source_refs":[{"purpose":"provenance","source":"source.legacy"}]},"machine.reservation":{"annotations":{"gdd.notes":["absent is a modeling marker for a reservation that does not yet exist; it is never stored.","The state machine describes mutations. Validation, errors and idempotent return paths are defined in the action contracts.","cancelled is terminal for mutations but may still be read and returned during an authorized retry."]},"description":"Reservation mutation lifecycle; retries and errors follow the action contracts.","kind":"machine","machine":{"initial":"absent","states":["absent","reserved","cancelled"],"terminal":["cancelled"],"transitions":[{"effects":"Create a reservation with state=reserved and bind the request key atomically under capacity protection.","from":"absent","guard":"Authenticated user; existing concert; new request key; at least one available seat.","id":"transition.reserve","to":"reserved","trigger":"action.reserve"},{"effects":"Atomically change to cancelled; any materialized seat counter is updated within the same transaction.","from":"reserved","guard":"The authenticated user owns the reservation.","id":"transition.cancel","to":"cancelled","trigger":"action.cancel"}]},"maturity":"specified"},"rule.api_boundary":{"description":"The API module must not import the persistence module directly.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"architecture","constraint":{"from":"component.api","policy":"forbid","reach":"direct","relation":"imports","to":"component.storage"},"scope":"targeted","statement":"The API module must not import the persistence module directly.","verification":["static_import_analysis"]}},"rule.atomicity":{"description":"Errors before commit leave no partially completed mutation or request-key binding.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Errors before commit leave no partially completed mutation or request-key binding.","verification":["database_fault_injection_tests"]}},"rule.authorization":{"description":"Only the owner may cancel or receive reservation data; the request body must not determine identity.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Only the owner may cancel or receive reservation data; the request body must not determine identity.","verification":["authorization_tests"]}},"rule.capacity":{"description":"For each concert, 0 <= count(reservations with state=reserved) <= capacity after every committed mutation.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"invariant","scope":"targeted","statement":"For each concert, 0 <= count(reservations with state=reserved) <= capacity after every committed mutation.","verification":["database_concurrency_and_integration_tests"]}},"rule.design.dry":{"description":"Reservation and cancellation reuse one authoritative definition of each business rule; similar code alone does not require abstraction.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"dry","scope":"global","statement":"Reservation and cancellation reuse one authoritative definition of each business rule; similar code alone does not require abstraction.","verification":["design_review"]}},"rule.design.kiss":{"description":"Each layer and abstraction serves a current requirement; prefer the smallest clear implementation.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"kiss","scope":"global","statement":"Each layer and abstraction serves a current requirement; prefer the smallest clear implementation.","verification":["design_review"]}},"rule.design.modularity":{"description":"Components collaborate through public contracts and can change their internals without exposing them to consumers.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"modularity","scope":"global","statement":"Components collaborate through public contracts and can change their internals without exposing them to consumers.","verification":["design_review"]}},"rule.design.separation_of_concerns":{"description":"Transport, reservation decisions and physical storage remain with their responsible components.","kind":"rule","rule":{"blocking":false,"category":"design","principle":"separation_of_concerns","scope":"global","statement":"Transport, reservation decisions and physical storage remain with their responsible components.","verification":["design_review"]}},"rule.idempotency":{"description":"Retries must not create extra reservations, reactivate cancelled reservations or release extra seats.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Retries must not create extra reservations, reactivate cancelled reservations or release extra seats.","verification":["integration_tests"]}},"rule.state_machine":{"description":"Mutating flows follow the state machine; cancelled reservation IDs cannot be reactivated.","kind":"rule","maturity":"specified","rule":{"blocking":true,"category":"behavior","scope":"targeted","statement":"Mutating flows follow the state machine; cancelled reservation IDs cannot be reactivated.","verification":["model_based_and_integration_tests"]}},"scenario.api_boundary":{"description":"The forbidden import must yield FAIL. An absent scan or unresolved mapping yields UNKNOWN, not PASS.","kind":"scenario","scenario":{"category":"architecture","given":"Component bindings point to the implemented project's modules.","then":"The forbidden import must yield FAIL. An absent scan or unresolved mapping yields UNKNOWN, not PASS.","when":"Extract the import graph; also insert a temporary direct API-to-storage import as a negative control."}},"scenario.atomic_failure":{"description":"Persistent state is unchanged after the failure; a successful retry applies the effect once. Also verify any counter and key binding.","kind":"scenario","scenario":{"category":"negative","given":"A valid reserve or cancel flow is ready for mutation.","then":"Persistent state is unchanged after the failure; a successful retry applies the effect once. Also verify any counter and key binding.","when":"The test adapter injects failures at relevant persistence boundaries before commit and lets the client retry."}},"scenario.cancel":{"description":"Same ID in cancelled; zero active reservations; available seats never exceed capacity.","kind":"scenario","scenario":{"category":"boundary","given":"A owns a reserved reservation for a concert with capacity=1.","then":"Same ID in cancelled; zero active reservations; available seats never exceed capacity.","when":"A cancels twice, including concurrent requests."}},"scenario.cancel_concurrent":{"description":"Both return the same cancelled ID; the seat is released only once.","kind":"scenario","scenario":{"category":"concurrency","given":"A ejer én reserved reservation.","then":"Both return the same cancelled ID; the seat is released only once.","when":"Two connections cancel concurrently."}},"scenario.cancel_once":{"description":"The same ID is returned as cancelled; one seat is released.","kind":"scenario","scenario":{"category":"normal","given":"A owns a reserved reservation.","then":"The same ID is returned as cancelled; one seat is released.","when":"A cancels once."}},"scenario.concurrent_same_key":{"description":"Both return the same reservation ID; exactly one reservation is created.","kind":"scenario","scenario":{"category":"concurrency","given":"C has capacity=2; A has not yet used K1.","then":"Both return the same reservation ID; exactly one reservation is created.","when":"A sends two identical reserve requests with K1 concurrently."}},"scenario.foreign_cancel":{"description":"ReservationNotFound; no change and no reservation data returned.","kind":"scenario","scenario":{"category":"negative","given":"A owns reservation R; B is authenticated as B.","then":"ReservationNotFound; no change and no reservation data returned.","when":"B attempts to cancel R, including a forged owner_id in the request body. Repeat for both reserved and cancelled states."}},"scenario.key_conflict":{"description":"IdempotencyConflict; no new reservation or capacity change in any concert.","kind":"scenario","scenario":{"category":"negative","given":"A has reserved concert C1 using K1.","then":"IdempotencyConflict; no new reservation or capacity change in any concert.","when":"A uses K1 for concert C2."}},"scenario.last_seat":{"description":"Exactly one reservation succeeds; the other yields SoldOut; at most one seat is occupied. Run against the selected database's actual transaction behavior.","kind":"scenario","scenario":{"category":"concurrency","given":"Concert C has one available seat; A and B each have a new request key.","then":"Exactly one reservation succeeds; the other yields SoldOut; at most one seat is occupied. Run against the selected database's actual transaction behavior.","when":"Two separate database connections attempt concurrent reservations with controlled overlap."}},"scenario.replay":{"description":"The same reservation ID is returned every time; no extra seat is occupied; no SoldOut on a retry.","kind":"scenario","scenario":{"category":"boundary","given":"C has capacity=1; A's reserve request with K1 succeeded and took the last seat.","then":"The same reservation ID is returned every time; no extra seat is occupied; no SoldOut on a retry.","when":"A repeats the same request several times, including concurrently."}},"scenario.replay_after_cancel":{"description":"K1 returns R in cancelled without mutation. K2 may create a new ID if capacity is available; R remains cancelled.","kind":"scenario","scenario":{"category":"boundary","given":"A reserved using K1 and then cancelled reservation R.","then":"K1 returns R in cancelled without mutation. K2 may create a new ID if capacity is available; R remains cancelled.","when":"A repeats the original reserve request with K1 and then creates a new one with K2."}},"scenario.reservation_missing":{"description":"ReservationNotFound without reservation data.","kind":"scenario","scenario":{"category":"negative","given":"Authenticated user; reservation does not exist.","then":"ReservationNotFound without reservation data.","when":"Cancel kaldes."}},"scenario.reserve":{"description":"One reservation ID in reserved for A, and exactly one seat occupied.","kind":"scenario","scenario":{"category":"normal","given":"Concert C has capacity=1 and no reservations; user A is authenticated.","then":"One reservation ID in reserved for A, and exactly one seat occupied.","when":"A reserves C using key K1."}},"scenario.sold_out":{"description":"SoldOut; no mutation or key binding.","kind":"scenario","scenario":{"category":"negative","given":"The concert is full; the user has a new key.","then":"SoldOut; no mutation or key binding.","when":"Reserve kaldes."}},"scenario.zero_capacity":{"description":"SoldOut; zero active reservations.","kind":"scenario","scenario":{"category":"boundary","given":"The concert has capacity=0.","then":"SoldOut; zero active reservations.","when":"A valid new reservation is attempted."}}},"edges":[{"from":"entity.concert","id":"edge.community.entity.concert","relation":"member_of","to":"community.backend"},{"from":"entity.reservation","id":"edge.community.entity.reservation","relation":"member_of","to":"community.backend"},{"from":"machine.reservation","id":"edge.community.machine.reservation","relation":"member_of","to":"community.backend"},{"from":"rule.api_boundary","id":"edge.constraint.rule.api_boundary.component.api","relation":"constrains","to":"component.api"},{"from":"rule.api_boundary","id":"edge.constraint.rule.api_boundary.component.storage","relation":"constrains","to":"component.storage"},{"from":"rule.atomicity","id":"edge.constraint.rule.atomicity.action.cancel","relation":"constrains","to":"action.cancel"},{"from":"rule.atomicity","id":"edge.constraint.rule.atomicity.action.reserve","relation":"constrains","to":"action.reserve"},{"from":"rule.authorization","id":"edge.constraint.rule.authorization.action.cancel","relation":"constrains","to":"action.cancel"},{"from":"rule.capacity","id":"edge.constraint.rule.capacity.entity.concert","relation":"constrains","to":"entity.concert"},{"from":"rule.capacity","id":"edge.constraint.rule.capacity.entity.reservation","relation":"constrains","to":"entity.reservation"},{"from":"rule.idempotency","id":"edge.constraint.rule.idempotency.action.cancel","relation":"constrains","to":"action.cancel"},{"from":"rule.idempotency","id":"edge.constraint.rule.idempotency.action.reserve","relation":"constrains","to":"action.reserve"},{"from":"rule.state_machine","id":"edge.constraint.rule.state_machine.machine.reservation","relation":"constrains","to":"machine.reservation"},{"from":"actio