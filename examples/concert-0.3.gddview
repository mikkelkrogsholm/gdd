nsport requests and forward trusted authentication context."},"interfaces_known":true,"public_contracts":[]},"component.frontend":{"boundary":{"excludes":["Authoritative seat allocation and access-control decisions."],"rationale":"Let presentation change while preserving the reservation operation contracts.","responsibility":"Present reservation interactions and their user-visible states."},"interfaces_known":true,"public_contracts":[]},"component.reservations":{"boundary":{"excludes":["Transport request/response translation.","Physical storage implementation."],"rationale":"Keep availability, atomicity and cancellation rules consistent behind one public interface.","responsibility":"Own reservation rules, access control and transaction decisions."},"interfaces_known":true,"public_contracts":[{"project_id":"concert-reservations","provider":"component.reservations","action":"action.reserve","spec_revision":"sha256:3a44421b96560abf0761f64e6d1a48db88a65f3f11f563ea134a33ffb1bf8d7b"},{"project_id":"concert-reservations","provider":"component.reservations","action":"action.cancel","spec_revision":"sha256:3a44421b96560abf0761f64e6d1a48db88a65f3f11f563ea134a33ffb1bf8d7b"}]},"component.storage":{"boundary":{"excludes":["Authentication and reservation policy decisions."],"rationale":"Isolate database-specific behavior behind the domain persistence boundary.","responsibility":"Implement persistence and transactions selected by the reservation component."},"interfaces_known":true,"public_contracts":[]}},"communities":{"community.backend":{"membership_basis":{"component.api":["component.api"],"component.reservations":["action.cancel","action.reserve","component.reservations","entity.concert","entity.reservation","machine.reservation"],"component.storage":["component.storage"]},"omitted_components":[],"omitted_calls":[],"unresolved_members":[],"public_contracts":[{"project_id":"concert-reservations","provider":"component.reservations","action":"action.reserve","spec_revision":"sh