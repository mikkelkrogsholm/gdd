{
  "format": "gdd/0.2",
  "project": {
    "id": "quote-demo",
    "title": "Graph-driven integer quote",
    "goal": "Native agents implement the accepted floor behavior and prove it through real unit and CLI tests.",
    "scope": "Three pure arithmetic interfaces and a reference CLI; no persistence, networking, legal or tax calculation service.",
    "assumptions": [
      "Amounts are abstract integer minor units; 10000 basis points means 100%.",
      "The Python reference app is one implementation of the language-independent graph.",
      "Existing half-up code is deliberately wrong; floor assertions remain unchanged during repairs."
    ],
    "workflow": {
      "mode": "custom",
      "mandate": "Bounded local development demo; the trusted host controls dispatch, integration and evidence.",
      "gates": {
        "model_changes": {
          "requirement": "none",
          "authorities": [
            "actor.demo_lead"
          ],
          "scope": [
            "action.discount",
            "action.tax",
            "action.quote"
          ]
        },
        "implementation": {
          "requirement": "none",
          "authorities": [
            "actor.demo_lead"
          ],
          "scope": [
            "action.discount",
            "action.tax",
            "action.quote"
          ]
        },
        "acceptance": {
