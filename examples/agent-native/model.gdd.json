    "action.discount": {
      "kind": "action",
      "description": "Calculate discount using the accepted floor contract.",
      "maturity": "specified",
      "source_refs": [
        {
          "source": "source.requirements",
          "purpose": "contract",
          "selector": {
            "kind": "whole-document"
          }
        }
      ],
      "contract": {
        "input": {
          "amount": {
            "type": "integer",
            "minimum": 0
          },
          "rate_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "context": {},
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "InvalidInput": "InvalidInput"
        },
        "preconditions": [
          "Reject non-integers, booleans, negative amounts and rates outside 0..10000 before calculation."
        ],
        "external_effects": [],
        "effects_complete": true,
        "dependencies_complete": true,
        "risks": {
          "authorization": {
            "relevant": false,
            "rationale": "Pure local arithmetic has no identity or protected data.",
            "scenarios": []
          },
          "idempotency": {
            "relevant": false,
            "rationale": "No request keys or external effects; equal input gives equal output.",
            "scenarios": []
          },
          "concurrency": {
            "relevant": false,
            "rationale": "No shared mutable state or persistence.",
            "scenarios": []
          },
          "atomicity": {
            "relevant": false,
            "rationale": "No mutations, commits, or external systems.",
            "scenarios": []
          },
          "boundaries": {
            "relevant": true,
            "rationale": "Exact integers, inclusive rate bounds and rounding boundaries require checks.",
            "scenarios": [
              "scenario.discount.floor",
              "scenario.discount.invalid"
            ]
          }
        },
        "error_cases": {
          "InvalidInput": [
            "scenario.discount.invalid"
          ]
        }
      },
      "behavior": "Validate exact integer inputs (excluding booleans), amount >= 0 and 0 <= rate_bps <= 10000; otherwise return InvalidInput. Return floor(amount * rate_bps / 10000), using exact integer arithmetic. Return the calculated amount, not the remaining balance."
    },
    "scenario.discount.normal": {
      "kind": "scenario",
      "description": "Return 1000.",
      "scenario": {
        "category": "normal",
        "given": "amount=10000 and rate_bps=1000",
        "when": "Calculate discount.",
        "then": "Return 1000."
      }
    },
    "scenario.discount.floor": {
      "kind": "scenario",
      "description": "Return 50 and 25 respectively. Zero amount/rate gives 0; rate 10000 returns the amount. Exact integer arithmetic also applies to large amounts.",
      "scenario": {
        "category": "boundary",
        "given": "amount=101, rate_bps=5000; also amount=103, rate_bps=2500",
        "when": "Calculate discount.",
        "then": "Return 50 and 25 respectively. Zero amount/rate gives 0; rate 10000 returns the amount. Exact integer arithmetic also applies to large amounts."
      }
    },
