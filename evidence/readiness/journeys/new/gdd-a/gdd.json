          "concurrency": {
            "relevant": false,
            "rationale": "No shared mutable state, I/O transaction, or persisted quote exists.",
            "scenarios": []
          },
          "atomicity": {
            "relevant": false,
            "rationale": "No multi-resource mutation or transaction is performed.",
            "scenarios": []
          }
        },
        "error_cases": {}
      },
      "behavior": "Parse WEIGHT as int and ZONE as domestic or remote. Reject a nonpositive weight. Call action.quote once, print the integer cents, and return 0. For invalid arguments return 2 after an English stderr error."
