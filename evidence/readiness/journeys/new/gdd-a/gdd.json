              "type": "string"
            }
          }
        },
        "context": {},
        "output": {
          "type": "integer"
        },
        "errors": {},
        "preconditions": [],
        "postconditions": [
          "On valid arguments print the quote and a newline and return exit code 0.",
          "Invalid/missing arguments print no quote and return 2 with an English stderr message."
        ],
        "external_effects": [
          "Write the quote to stdout or argument errors to stderr."
        ],
        "effects_complete": true,
        "dependencies_complete": true,
        "risks": {
          "authorization": {
            "relevant": false,
            "rationale": "Public local price calculation needs no identity or privileged effects.",
            "scenarios": []
          },
          "idempotency": {
            "relevant": false,
            "rationale": "Calculation has no domain mutation; repeated quotes are independent.",
            "scenarios": []
          },
          "boundaries": {
            "relevant": true,
            "rationale": "Validate positive integer weight and allowed zone; enforce exact kilogram boundaries.",
            "scenarios": [
