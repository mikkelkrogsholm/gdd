          "machine.reservation": {
            "kind": "machine",
            "description": "Draft starts the lifecycle; cancellation is terminal for state-changing transitions.",
            "maturity": "specified",
            "machine": {
              "states": [
                "draft",
                "reserved",
                "cancelled"
