              "transitions": [
                {
                  "id": "transition.reserve",
                  "from": "draft",
                  "to": "reserved",
                  "trigger": "action.reserve",
                  "guard": "state equals draft",
                  "effects": "Set state to reserved; preserve object identity."
                },
                {
                  "id": "transition.cancel",
                  "from": "reserved",
                  "to": "cancelled",
                  "trigger": "action.cancel",
                  "guard": "state equals reserved",
                  "effects": "Set state to cancelled; preserve object identity."
                }
              ]
            }
          },
          "rule.lifecycle": {
            "kind": "rule",
            "description": "The agreed lifecycle, stable signature, identity and idempotency are fixed acceptance assertions.",
            "maturity": "specified",
            "source_refs": [
              {
                "source": "source.brief",
                "purpose": "contract"
              }
            ],
            "rule": {
              "category": "behavior",
              "statement": "Reservation defaults to draft. reserve(value: Reservation) -> Reservation preserves identity, reserves draft, leaves repeat reserve harmless, and raises InvalidTransition without mutation on cancelled. cancel cancels reserved, leaves repeat cancel harmless, and preserves identity. Cancel on draft raises InvalidTransition without mutation.",
              "scope": "global",
              "blocking": true,
              "verification": [
                "unittest"
              ]
            }
          },
