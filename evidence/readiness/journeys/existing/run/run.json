              "rule": {
                "category": "behavior",
                "statement": "Reservation defaults to draft; reserve retains its signature and identity, draft -> reserved, repeat reserved no-op; cancel reserved -> cancelled, repeat cancelled no-op; reserve cancelled rejects InvalidTransition without mutation.",
