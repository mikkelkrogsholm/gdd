{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdd.example/schemas/0.2/view-state.schema.json",
  "title": "Informative gdd-viewer 0.1 view-state envelope",
  "type": "object",
  "properties": {
    "format": {
      "const": "gdd-view-state/0.2"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "const": "gdd-viewer"
        },
        "version": {
          "const": "0.1.3"
        },
        "profile": {
          "const": "gdd-viewer-html/0.1"
        }
      },
      "required": [
        "name",
        "version",
        "profile"
      ],
      "additionalProperties": false
    },
    "spec_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "observation_inputs": {
      "const": []
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "artifact_scope": {
      "type": "object",
      "properties": {
        "shown_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "shown_edges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "omitted_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "omitted_edges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "shown_nodes",
        "shown_edges",
        "omitted_nodes",
        "omitted_edges"
      ],
      "additionalProperties": false
    },
    "filters": {
      "type": "object",
      "properties": {
        "search": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "community": {
          "type": "string"
        },
        "scenarios": {
          "type": "boolean"
        }
      },
      "required": [
        "search",
        "kind",
        "relation",
        "community",
        "scenarios"
      ],
      "additionalProperties": false
    },
    "folding": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "overlap_policy": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "overlap_policy"
      ],
      "additionalProperties": false
    },
    "shown_nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "shown_edges": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "omitted_nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "omitted_edges": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "glyphs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "node_ids"
        ],
        "additionalProperties": false
      }
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "edge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "from",
          "to",
          "edge_ids"
        ],
        "additionalProperties": false
      }
    },
    "folded_internal_edges": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "generator",
    "spec_revision",
    "observation_inputs",
    "scope",
    "artifact_scope",
    "filters",
    "folding",
    "shown_nodes",
    "shown_edges",
    "omitted_nodes",
    "omitted_edges",
    "glyphs",
    "bundles",
    "folded_internal_edges"
  ],
  "additionalProperties": false
}
