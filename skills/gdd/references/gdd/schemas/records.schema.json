{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdd.example/schemas/0.2/records.schema.json",
  "title": "GDD 0.2 records.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "gdd-records/0.2"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
    },
    "records": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "binding"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "supersedes": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
              },
              "spec_revision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "implementation": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
              },
              "role": {
                "enum": [
                  "code",
                  "test",
                  "design"
                ]
              },
              "resource": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "$ref": "#/$defs/selector"
              },
              "status": {
                "enum": [
                  "planned",
                  "observed",
                  "checked"
                ]
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "code_revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "spec_revision",
              "targets",
              "implementation",
              "role",
              "resource",
              "selector",
              "status"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "observed",
                        "checked"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "revision"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "observed",
                        "checked"
                      ]
                    },
                    "role": {
                      "enum": [
                        "code",
                        "test"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "code_revision"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "decision"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "supersedes": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
              },
              "topic": {
                "enum": [
                  "model_change",
                  "approval",
                  "readiness_review",
                  "exception",
                  "source_promotion"
                ]
              },
              "activity": {
                "enum": [
                  "model_changes",
                  "implementation",
                  "acceptance"
                ]
              },
              "implementation": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
              },
              "code_revision": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "spec_revision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
              },
              "policy_revision": {
                "type": "string",
                "minLength": 1
              },
              "actor": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
                  },
                  "kind": {
                    "enum": [
                      "human",
                      "agent",
                      "tool"
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind"
                ],
                "additionalProperties": false
              },
              "outcome": {
                "enum": [
                  "proposed",
                  "accepted",
                  "rejected"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "kind",
              "topic",
              "scope",
              "spec_revision",
              "policy_revision",
              "actor",
              "outcome",
              "rationale"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "topic": {
                      "const": "exception"
                    }
                  }
                },
                "then": {
                  "required": [
                    "checks",
                    "expires_at",
                    "implementation",
                    "code_revision"
                  ],
                  "properties": {
                    "checks": {
                      "minItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "topic": {
                      "const": "approval"
                    }
                  }
                },
                "then": {
                  "required": [
                    "activity"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "topic": {
                      "const": "approval"
                    },
                    "activity": {
                      "const": "acceptance"
                    }
                  },
                  "required": [
                    "activity"
                  ]
                },
                "then": {
                  "required": [
                    "implementation",
                    "code_revision"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "check"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "supersedes": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
              },
              "spec_revision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "required_environment": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "negative_controls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "kind",
              "spec_revision",
              "scope",
              "method",
              "required_environment",
              "negative_controls"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "evidence"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "supersedes": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
              },
              "check": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
              },
              "check_revision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
              },
              "implementation": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
              },
              "spec_revision": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "code_revision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "checker": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "version"
                ],
                "additionalProperties": false
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "result": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "executed": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "evidence_uri": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "check",
              "check_revision",
              "implementation",
              "spec_revision",
              "code_revision",
              "checker",
              "scope",
              "result",
              "executed",
              "reason",
              "environment",
              "evidence_uri"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "result": {
                      "const": "PASS"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "executed": {
                      "const": true
                    },
                    "spec_revision": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                    },
                    "code_revision": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "project_id",
    "records"
  ],
  "additionalProperties": false,
  "$defs": {
    "selector": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "whole-document",
            "json-pointer",
            "markdown-heading",
            "line-range",
            "opaque"
          ]
        },
        "value": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "whole-document"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "json-pointer",
                  "markdown-heading",
                  "line-range",
                  "opaque"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ]
    }
  }
}
