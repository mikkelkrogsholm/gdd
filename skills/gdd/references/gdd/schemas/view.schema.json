{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdd.example/schemas/0.2/view.schema.json",
  "title": "Informative gdd-viewer 0.1 view envelope",
  "type": "object",
  "properties": {
    "format": {
      "const": "gdd-view/0.2"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "const": "gdd-viewer"
        },
        "version": {
          "const": "0.2.1"
        },
        "profile": {
          "const": "gdd-viewer-html/0.1"
        }
      },
      "required": [
        "name",
        "version",
        "profile"
      ],
      "additionalProperties": false
    },
    "spec_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "observation_inputs": {
      "const": []
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "model": {
      "oneOf": [
        {
          "$ref": "https://gdd.example/schemas/0.3/gdd.schema.json"
        },
        {
          "$ref": "https://gdd.example/schemas/0.2/gdd.schema.json"
        }
      ]
    },
    "locations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "snapshot": {
      "type": [
        "object",
        "null"
      ]
    },
    "text": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "full": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "full",
              "fields"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "full": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "full",
              "fields"
            ],
            "additionalProperties": false
          }
        },
        "questions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "full": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "full",
              "fields"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "project": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        },
        "references": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "nodes",
        "sources",
        "questions",
        "edges",
        "project",
        "snapshot",
        "references"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "shown_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "shown_edges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "omitted_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "omitted_edges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*(?![\\s\\S])"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "shown_nodes",
        "shown_edges",
        "omitted_nodes",
        "omitted_edges"
      ],
      "additionalProperties": false
    },
    "boundaries": {
      "type": "object",
      "properties": {
        "format": {
          "const": "gdd-boundaries/0.3"
        },
        "spec_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "boundary": {
                "type": "object",
                "properties": {
                  "responsibility": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "rationale": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "excludes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              },
              "interfaces_known": {
                "type": "boolean"
              },
              "public_contracts": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/boundary_contract"
                }
              }
            },
            "required": [
              "boundary",
              "interfaces_known",
              "public_contracts"
            ],
            "additionalProperties": false
          }
        },
        "communities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "membership_basis": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "uniqueItems": true
                }
              },
              "omitted_components": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "uniqueItems": true
              },
              "unresolved_members": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "uniqueItems": true
              },
              "public_contracts": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/boundary_contract"
                }
              },
              "calls": {
                "type": "object",
                "properties": {
                  "inbound": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "uniqueItems": true
                  },
                  "outbound": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "uniqueItems": true
                  },
                  "internal": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "uniqueItems": true
                  },
                  "unresolved": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "inbound",
                  "outbound",
                  "internal",
                  "unresolved"
                ],
                "additionalProperties": false
              },
              "omitted_calls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "membership_basis",
              "omitted_components",
              "unresolved_members",
              "public_contracts",
              "calls",
              "omitted_calls"
            ],
            "additionalProperties": false
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "edge": {
                "type": "string",
                "pattern": "\\S"
              },
              "source": {
                "type": "string",
                "pattern": "\\S"
              },
              "consumer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "action": {
                "type": "string",
                "pattern": "\\S"
              },
              "status": {
                "enum": [
                  "public",
                  "internal",
                  "private",
                  "unresolved"
                ]
              }
            },
            "required": [
              "edge",
              "source",
              "consumer",
              "provider",
              "action",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "omitted_calls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "format",
        "spec_revision",
        "scope",
        "components",
        "communities",
        "calls",
        "unresolved",
        "omitted_calls"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "generator",
    "spec_revision",
    "observation_inputs",
    "scope",
    "model",
    "locations",
    "snapshot",
    "text",
    "manifest"
  ],
  "additionalProperties": false,
  "$defs": {
    "boundary_contract": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "provider": {
          "type": "string",
          "pattern": "\\S"
        },
        "action": {
          "type": "string",
          "pattern": "\\S"
        },
        "spec_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "project_id",
        "provider",
        "action",
        "spec_revision"
      ],
      "additionalProperties": false
    }
  }
}
