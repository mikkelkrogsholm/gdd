{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GDD code observation 0.1 (informative tool contract; not core implementation evidence)",
  "type": "object",
  "properties": {
    "format": {
      "const": "gdd-code-observation/0.1"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "python",
        "implementation"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "code_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ignored_directories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "component": {
            "type": [
              "string",
              "null"
            ]
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "observed",
              "checked"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "declared_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "declared_code_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "record_revision": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "component",
          "resource",
          "status",
          "files",
          "declared_revision",
          "declared_code_revision",
          "record_revision"
        ],
        "additionalProperties": false
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/import"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "advisory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": true
      }
    },
    "notice": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "format",
    "tool",
    "profile",
    "implementation",
    "spec_revision",
    "code_revision",
    "scope",
    "source_root",
    "exclude",
    "ignored_directories",
    "omitted",
    "files",
    "bindings",
    "imports",
    "edges",
    "constraints",
    "checks",
    "result",
    "advisory",
    "notice",
    "runtime"
  ],
  "additionalProperties": false,
  "$defs": {
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "properties": {
            "file": {
              "type": [
                "string",
                "null"
              ]
            },
            "pointer": {
              "type": "string"
            },
            "line": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "column": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "file",
            "pointer",
            "line",
            "column"
          ],
          "additionalProperties": false
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "location",
        "related_ids"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "target_file": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "from",
        "to",
        "source_file",
        "line",
        "column",
        "module",
        "target_file",
        "statement"
      ],
      "additionalProperties": false
    },
    "import": {
      "type": "object",
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "module": {
          "type": "string"
        },
        "target_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "imported": {
          "type": [
            "string",
            "null"
          ]
        },
        "external": {
          "type": "boolean"
        }
      },
      "required": [
        "source_file",
        "line",
        "column",
        "module",
        "target_file",
        "statement",
        "imported",
        "external"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "reach": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "rule",
        "relation",
        "from",
        "to",
        "reach",
        "policy"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "const": "integration"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      },
      "required": [
        "check_id",
        "dimension",
        "result",
        "scope",
        "reason",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  }
}
